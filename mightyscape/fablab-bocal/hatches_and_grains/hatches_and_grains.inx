<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Hachures et trames</name>
    <id>fablabchemnitz.de.hatches_and_grains</id>
    <param name="tab" type="notebook">
        <page name="splash" gui-text="Hachures">
            <label>Crée des hachures normalisées pour différencier ou hiérarchiser des objets cartographiques.</label>
            <label appearance="header">Réglages des hachures</label>
            <param name="type" type="optiongroup" appearance="combo" gui-text="Type de hachures :">
                <option value="h">Continues</option>
                <option value="d">Discontinues</option>
            </param>
            <param name="angle" type="optiongroup" appearance="combo" gui-text="Orientation :">
                <option value="0">―</option>
                <option value="135">⟋</option>
                <option value="90">|</option>
                <option value="45">⟍</option>
            </param>
            <param name="thickness" type="optiongroup" appearance="combo" gui-text="Épaisseur :">
                <option value="1">1px</option>
                <option value="3">3px</option>
                <option value="5">5px</option>
            </param>
            <param name="spacing" type="optiongroup" appearance="combo" gui-text="Espacement :">
                <option value="8">8px</option>
                <option value="10">10px</option>
                <option value="12">12px</option>
                <option value="15">15px</option>
                <option value="20">20px</option>
                <option value="25">25px</option>
                <option value="30">30px</option>
                <option value="40">40px</option>
                <option value="50">50px</option>
            </param>
            <label appearance="header">Couleur des hachures</label>
            <param name="hcolor" type="color" gui-text="Couleur des hachures" />
        </page>
        <page name="grains_page" gui-text="Trames">
            <label>Crée des trames normalisées pour différencier ou hiérarchiser des objets cartographiques.</label>
            <label appearance="header">Réglages des trames</label>
            <param name="type_grain" type="optiongroup" appearance="combo" gui-text="Trames :">
                <option value="grain_v">V</option>
                <option value="grain_m">ʌ</option>
                <option value="grain_p">+</option>
                <option value="grain_x">X</option>
                <option value="grain_c">○</option>
                <option value="grain_r">●</option>
            </param>
            <param name="size" type="optiongroup" appearance="combo" gui-text="Taille :">
                <option value="1">Très petite</option>
                <option value="2">Petite</option>
                <option value="3">Moyenne</option>
                <option value="4">Grande</option>
            </param>
            <label appearance="header">Couleur de la trame</label>
            <param name="gcolor" type="color" gui-text="Couleur de la trame" />
        </page>
        <page name="info" gui-text="Informations">
            <label xml:space="preserve">Ce module de cartographie s'adresse aux géographes et cartographes.

Il permet de créer des variables visuelles comme les « hachures » ou les « trames » sur des surfaces ou des points, pour différencier ou hiérarchiser l'information cartographique.

Laurent Porcheret
Géographe - cartographe
Sorbonne université - INSPE de Paris
V.15.01.2020</label>
        </page>
    </param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Formes et motifs"><submenu name="À partir d'objets" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">hatches_and_grains.py</command>
    </script>
</inkscape-extension>