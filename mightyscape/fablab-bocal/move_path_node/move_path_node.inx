<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Déplacer le nœud de départ</name>
    <id>fablabchemnitz.de.move_path_node</id>
    <param name="tab" type="notebook">
        <page name="tab_settings" gui-text="Modifier le nœud de départ du chemin">
            <param name="closed_only" type="bool" gui-text="Chemins fermés seulement" gui-description="Si désactivé, s'applique aussi aux (sous-)chemins ouverts. Attention : cela SUPPRIME des segments !">true</param>
            <param name="movenode" appearance="full" type="int" min="-9999" max="9999" gui-text="Avancer le nœud de n nœuds">0</param>
            <param name="visualize_result" type="bool" gui-text="Afficher les deux premiers nœuds" gui-description="Si activé, les deux premiers nœuds reçoivent un numéro et un point">false</param>
            <param name="fontsize" type="string" gui-text="Taille de police :">10px</param>
            <param name="dotsize" type="string" gui-text="Taille des points :">10px</param>
            <param name="debug" type="bool" gui-text="Informations de débogage">false</param>
            <label appearance="header">Remarques</label>
            <label>Utilisez « Chemin &gt; Inverser » pour changer le sens du chemin</label>
            <label>Utilisez l'extension « Enchaîner les chemins » pour faire des chemins fermés à partir de segments.</label>
        </page>
        <page name="tab_about" gui-text="À propos">
            <label appearance="header">Déplacer le nœud de départ</label>
            <label>Change le nœud de début / fin d'un chemin et l'affiche par des points et des numéros. Peut aussi servir à rogner des chemins ouverts.</label>
            <label>2021 - 2025 / écrit par Mario Voigt (Stadtfabrikanten e.V. / FabLab Chemnitz)</label>
            <spacer />
            <label appearance="header">Documentation en ligne</label>
            <label appearance="url">https://y.stadtfabrikanten.org/movepathnode</label>
            <spacer />
            <label appearance="header">Contribuer</label>
            <label appearance="url">https://gitea.fablabchemnitz.de/FabLab_Chemnitz/mightyscape-1.2</label>
            <label appearance="url">mailto:mario.voigt@stadtfabrikanten.org</label>
            <spacer />
            <label appearance="header">Collection d'extensions MightyScape</label>
            <label>Ce logiciel fait partie de la collection d'extensions MightyScape pour Inkscape, sous licence GNU GPL v3</label>
            <label appearance="url">https://y.stadtfabrikanten.org/mightyscape-overview</label>
        </page>
        <page name="tab_donate" gui-text="Faire un don">
            <label appearance="header">Café + pizza</label>
            <label>Nous sommes les Stadtfabrikanten, qui font vivre le FabLab Chemnitz depuis 2016. Un FabLab est un atelier ouvert qui donne accès à des machines et des outils numériques : imprimantes 3D, découpeuses laser, fraiseuses CNC.</label>
            <spacer />
            <label>Vous aimez notre travail et voulez nous soutenir ? Vous pouvez faire un don à notre association de différentes façons :</label>
            <label appearance="url">https://y.stadtfabrikanten.org/donate</label>
            <spacer />
            <label>Merci d'utiliser notre extension et de nous aider !</label>
            <image>../000_about_fablabchemnitz.svg</image>
        </page>
    </param>
    <effect>
        <object-type>path</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Chemins"><submenu name="Joindre et ordonner" /></submenu></submenu></effects-menu>
       <menu-tip>Change starting / end node of a path and visualize it by dots and numbers. You can also use this extension as a trimmer for open paths.</menu-tip>
       <icon>icon.svg</icon>
    </effect>
    <script>
        <command location="inx" interpreter="python">move_path_node.py</command>
    </script>
</inkscape-extension>