<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Spirographe</name>
    <id>fablabchemnitz.de.spirograph</id>
    <param name="curveType" type="optiongroup" appearance="combo" gui-text="Type de courbe :">
        <option value="Epitrochoid">Épitrochoïde</option>
        <option value="Hypotrochoid">Hypotrochoïde</option>
    </param>
    <label appearance="header">Paramètres de la courbe</label>
    <param name="radius_R" type="int" min="1" max="1000" gui-text="Rayon du cercle fixe (R) :">10</param>
    <param name="radius_r" type="int" min="-1000" max="1000" gui-text="Rayon du cercle roulant (r) :">5</param>
    <param name="pencil_distance" type="int" min="-1000" max="1000" gui-text="Distance du crayon¹ (d) :">2</param>
    <label>¹ utiliser d=r pour une épi/hypocycloïde.</label>
    <label appearance="header">Paramètres du tracé</label>
    <param name="detailLevel" type="int" min="1" max="10" gui-text="Niveau de détail :">1</param>
    <param name="drawBaseCircles" type="bool" gui-text="Dessiner les cercles de base">false</param>
    <param name="animate" type="bool" gui-text="Animer">false</param>
    <param type="path" name="directory" gui-text="Dossier de l'animation :" mode="folder" />
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Formes et motifs"><submenu name="Générateurs" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">spirograph.py</command>
    </script>
</inkscape-extension>