<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Inklin (rosaces d'arcs)</name>
    <id>fablabchemnitz.de.inklin</id>
    <effect implements-custom-gui="true">
        <object-type>path</object-type>
        <effects-menu>
         <submenu name="FabLab Boc@l"><submenu name="Formes et motifs"><submenu name="Générateurs" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">inklin.py</command>
    </script>
</inkscape-extension>