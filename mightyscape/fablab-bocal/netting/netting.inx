<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Maillage de lignes</name>
    <id>fablabchemnitz.de.netting</id>
    <param name="tab" type="notebook">
        <page name="tab_settings" gui-text="Paramètres">
            <param name="netting_type" type="optiongroup" appearance="combo" gui-text="Type de maillage">
                <option value="alternatingly">en alternance</option>
                <option value="allwithall">tous avec tous</option>
            </param>
            <param name="node_shifting" type="int" min="-1000" max="1000" gui-text="Décalage des nœuds" gui-description="Ne s'applique pas au type « tous avec tous ».">0</param>
            <param name="stroke_width" type="float" precision="3" min="0.001" gui-text="Épaisseur du contour (px)">1.000</param>
            <param name="allwithall_limit" type="int" min="1" max="1000" gui-text="Nombre maximal de lignes à générer" gui-description="Seulement pour « tous avec tous ». Le nombre de boucles est limité, car 100 nœuds donnent déjà 100x100 = 10000 nœuds maillés. Des valeurs plus élevées peuvent facilement faire planter Inkscape !">100</param>
        </page>
        <page name="tab_about" gui-text="À propos">
            <label appearance="header">Maillage de lignes</label>
            <label>Cet effet maille (en alternance) les chemins sélectionnés. D'après le travail de Sunabe Kazumichi.</label>
            <label>2019 - 2023 / écrit par Mario Voigt (Stadtfabrikanten e.V. / FabLab Chemnitz)</label>
            <spacer />
            <label appearance="header">Documentation en ligne</label>
            <label appearance="url">https://y.stadtfabrikanten.org/netting</label>
            <spacer />
            <label appearance="header">Contribuer</label>
            <label appearance="url">https://gitea.fablabchemnitz.de/FabLab_Chemnitz/mightyscape-1.2</label>
            <label appearance="url">mailto:mario.voigt@stadtfabrikanten.org</label>
            <spacer />
            <label appearance="header">Collection d'extensions MightyScape</label>
            <label>Ce logiciel fait partie de la collection d'extensions MightyScape pour Inkscape, sous licence GNU GPL v3</label>
            <label appearance="url">https://y.stadtfabrikanten.org/mightyscape-overview</label>
        </page>
        <page name="tab_donate" gui-text="Faire un don">
            <label appearance="header">Café + pizza</label>
            <label>Nous sommes les Stadtfabrikanten, qui font vivre le FabLab Chemnitz depuis 2016. Un FabLab est un atelier ouvert qui donne accès à des machines et des outils numériques : imprimantes 3D, découpeuses laser, fraiseuses CNC.</label>
            <spacer />           
            <label>Vous aimez notre travail et voulez nous soutenir ? Vous pouvez faire un don à notre association de différentes façons :</label>
            <label appearance="url">https://y.stadtfabrikanten.org/donate</label>
            <spacer />
            <label>Merci d'utiliser notre extension et de nous aider !</label>
            <image>../000_about_fablabchemnitz.svg</image>
        </page>
    </param>
    <effect>
        <object-type>path</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Formes et motifs"><submenu name="À partir de chemins" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">netting.py</command>
    </script>
</inkscape-extension>