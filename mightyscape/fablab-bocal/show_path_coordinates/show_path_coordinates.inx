<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Afficher les coordonnées du chemin</name>
    <id>fablabchemnitz.de.show_path_coordinates</id>
    <effect needs-live-preview="false">
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Grilles, repères et mesures" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">show_path_coordinates.py</command>
    </script>
</inkscape-extension>