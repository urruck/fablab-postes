<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Cylindre Cut-Craft</name>
    <id>fablabchemnitz.de.cutcraft.cylinder</id>
    <param name="unit" gui-text="Unités de mesure" gui-description="Unité de mesure de toutes les valeurs saisies dans cette fenêtre." type="optiongroup" appearance="combo">
        <option value="mm">mm</option>
        <option value="cm">cm</option>
        <option value="in">in</option>
    </param>
    <separator />
    <param name="height" type="float" min="10.0" max="1000.0" precision="3" gui-text="Hauteur" gui-description="Hauteur du cylindre">60.0</param>
    <param name="outer" type="float" min="0.1" max="1000.0" precision="3" gui-text="Diamètre extérieur" gui-description="Diamètre extérieur du cylindre">60.0</param>
    <param name="inner" type="float" min="0.1" max="1000.0" precision="3" gui-text="Diamètre intérieur" gui-description="Diamètre intérieur du cylindre">30.0</param>
    <param name="vertices" type="int" min="3" max="180" gui-text="Nombre de sommets (3..180)" gui-description="Nombre de sommets du cylindre (3 = triangle, 4 = carré, ... 90 = cercle)">3</param>
    <param name="levels" type="int" min="2" max="100" gui-text="Nombre de niveaux (2..100)" gui-description="Nombre de plateaux circulaires horizontaux">2</param>
    <param name="supports" type="int" min="3" max="18" gui-text="Nombre de montants (3..18)" gui-description="Nombre de montants verticaux qui tiennent le cylindre">3</param>
    <param name="supwidth" type="float" min="0.1" max="1000.0" gui-text="Largeur des montants" gui-description="Largeur des montants verticaux qui tiennent le cylindre">6.0</param>
    <separator />
    <param name="thickness" type="float" min="0.1" max="1000.0" precision="3" gui-text="Épaisseur du matériau" gui-description="Épaisseur du matériau">5.0</param>
    <param name="kerf" type="float" min="0.0" max="1000.0" precision="3" gui-text="Trait de coupe laser" gui-description="Trait de coupe laser (tolérance). Dépend de la machine et de l'épaisseur du matériau">0.01</param>
    <param name="linethickness" gui-text="Épaisseur du trait" gui-description="Épaisseur de la ligne de coupe à l'écran" type="optiongroup" appearance="combo">
        <option value="1px">1 pixel</option>
        <option value="0.002in">trait fin</option>
    </param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Boîtes (autres modèles)"><submenu name="À encoches" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">cutcraftcylinder.py</command>
    </script>
</inkscape-extension>