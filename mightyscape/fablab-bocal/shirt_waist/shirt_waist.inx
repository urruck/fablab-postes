<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Patron de chemisier (Sara May Allington)</name>
    <id>fablabchemnitz.de.shirt_waist</id>
    <param name="m_unit" type="optiongroup" appearance="combo" gui-text="Unité de mesure :">
        <option value="Inches">Pouces</option>
        <option value="Centimeters">Centimètres</option>
    </param>
    <param name="m_front_waist_length" type="float" min="1.0" max="100.0" gui-text="Longueur taille devant">15.0</param>
    <param name="m_back_waist_length" type="float" min="1.0" max="100.0" gui-text="Longueur taille dos">15.5</param>
    <param name="m_neck_circumference" type="float" min="1.0" max="100.0" gui-text="Tour de cou">13.5</param>
    <param name="m_bust_circumference" type="float" min="1.0" max="100.0" gui-text="Tour de poitrine">39.0</param>
    <param name="m_waist_circumference" type="float" min="1.0" max="100.0" gui-text="Tour de taille">25.0</param>
    <param name="m_armscye_circumference" type="float" min="1.0" max="100.0" gui-text="Tour d'emmanchure">15.0</param>
    <param name="m_across_back" type="float" min="1.0" max="100.0" gui-text="Carrure dos">13.5</param>
    <param name="m_side" type="float" min="1.0" max="100.0" gui-text="Côté">7.75</param>
    <param name="m_upper_front_height" type="float" min="1.0" max="100.0" gui-text="Hauteur haut devant">10.75</param>
    <param name="m_overarm_length" type="float" min="1.0" max="100.0" gui-text="Longueur de bras">20.00</param>
    <param name="m_elbow_height" type="float" min="1.0" max="100.0" gui-text="Hauteur du coude (du poignet au coude)">9.50</param>
    <param name="m_elbow_circumference" type="float" min="1.0" max="100.0" gui-text="Tour de coude">12.50</param>
    <param name="m_hand_circumference" type="float" min="1.0" max="100.0" gui-text="Tour de main">8.00</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Divers" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">shirt_waist.py</command>
    </script>
</inkscape-extension>