<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Tour de Kresling</name>
    <id>org.inkscape.Origami_patterns.cylindrical_kresling</id>
    <param name="active-tab" type="notebook">
        <page name="options" gui-text="Options">
            <param name="pattern" type="optiongroup" appearance="combo" gui-text="Type de tour de Kresling">
                <option value="regular">Régulière</option>
                <option value="mirrowed">Cellules impaires en miroir</option>
            </param>
            <separator />
            <param name="rows" type="int" min="1" max="100" gui-text="Nombre de cellules">3</param>
            <param name="sides" type="int" min="3" max="100" gui-text="Nombre de côtés du polygone">6</param>
            <separator />
            <param name="measure_value" type="float" max="10000" precision="3" gui-text="Valeur de mesure :">10.0</param>
            <param name="measure_type" type="optiongroup" appearance="combo" gui-text="Type de mesure :">
                <option value="a">Côté du polygone (a)</option>
                <option value="b">Pli montagne vertical (b)</option>
                <option value="l">Pli vallée diagonal (l)</option>
                <option value="radius_external">Rayon extérieur</option>
                <option value="radius_internal">Rayon intérieur (complètement fermée)</option>
                <option value="diameter_external">Diamètre extérieur</option>
                <option value="diameter_internal">Diamètre intérieur (complètement fermée)</option>
            </param>
            <param name="units" type="optiongroup" appearance="combo" gui-text="Unités">
                <option value="mm">mm</option>
                <option value="cm">cm</option>
                <option value="in">in</option>
                <option value="pt">pt</option>
                <option value="px">px</option>
            </param>
            <param name="simulation_mode" type="bool" gui-text="Mode simulation">true</param>
            <separator />
            <param name="parameter_type" type="optiongroup" appearance="combo" gui-text="Type de paramètre :">
                <option value="angle_ratio">Rapport d'angle (lambda)</option>
                <option value="radial_ratio">Rapport radial</option>
                <option value="lambdatheta">Angle entre a et l (lambda × thêta)</option>
            </param>
            <param name="radial_ratio" type="float" min="0" max="0.7" precision="3" gui-text="Rapport radial :">0.5</param>
            <param name="angle_ratio" type="float" min="0.5" max="1" precision="3" gui-text="Rapport d'angle :">0.5</param>
            <param name="lambdatheta" type="float" min="15" max="90" precision="2" gui-text="Angle entre a et l">60.0</param>
        </page>
        <page name="slots" gui-text="Fentes">
            <param name="extra_column" type="bool" gui-text="Colonne en plus ?">false</param>
            <separator />
            <param name="add_base_slot" type="bool" gui-text="Ajouter des fentes à la base ?">false</param>
            <param name="base_slot_position" type="optiongroup" appearance="combo" gui-text="Position des fentes de la base :">
                <option value="-1">Haut</option>
                <option value="0">Centre</option>
                <option value="1">Bas</option>
            </param>
            <param name="base_height" type="float" max="10000" precision="3" gui-text="Hauteur de la base">5.0</param>
            <param name="base_slot_height" type="float" max="10000" precision="3" gui-text="Hauteur des fentes de la base">3.0</param>
            <param name="base_slot_width" type="float" max="10000" precision="3" gui-text="Largeur des fentes de la base">3.0</param>
            <separator />
            <param name="add_middle_slot" type="bool" gui-text="Ajouter des fentes entre les cellules ?">false</param>
            <param name="middle_slot_position" type="optiongroup" appearance="combo" gui-text="Position des fentes du milieu :">
                <option value="-1">Haut</option>
                <option value="0">Centre</option>
                <option value="1">Bas</option>
            </param>
            <param name="distance" type="float" max="10000" precision="3" gui-text="Distance entre les cellules">3.0</param>
            <param name="middle_slot_height" type="float" max="10000" precision="3" gui-text="Hauteur des fentes entre cellules">3.0</param>
            <param name="middle_slot_width" type="float" max="10000" precision="3" gui-text="Largeur des fentes entre cellules">3.0</param>
        </page>
        <page name="cuts" gui-text="Découpes">
            <param name="cut_bool" type="bool" gui-text="Dessiner les découpes ?">true</param>
            <param name="cut_bool_only" type="bool" gui-text="Dessiner SEULEMENT les découpes ?">true</param>
            <param name="cut_dashes_bool" type="bool" gui-text="Contours en pointillés ?">false</param>
            <param name="cut_dashes_len" type="float" min="0.1" max="10" appearance="full" precision="2" gui-text="Découpes : longueur tiret + espace">1</param>
            <param name="cut_dashes_duty" type="float" min="0.1" max="1" appearance="full" precision="2" gui-text="Découpes : part du tiret">0.25</param>
            <param name="cut_stroke_width" type="float" min="0.01" max="3" appearance="full" gui-text="Épaisseur des découpes">0.1</param>
            <param name="cut_stroke_color" type="color" gui-text="Couleur des découpes :">16711935</param>
        </page>
        <page name="mountains" gui-text="Plis montagne">
            <param name="mountain_bool" type="bool" gui-text="Dessiner les plis montagne ?">true</param>
            <param name="mountain_bool_only" type="bool" gui-text="Dessiner SEULEMENT les plis montagne ?">false</param>
            <param name="mountain_dashes_bool" type="bool" gui-text="Contours en pointillés ?">true</param>
            <param name="mountain_dashes_len" type="float" min="0.1" max="10" appearance="full" precision="2" gui-text="Plis montagne : longueur tiret + espace">1</param>
            <param name="mountain_dashes_duty" type="float" min="0.1" max="1" appearance="full" precision="2" gui-text="Plis montagne : part du tiret">0.5</param>
            <param name="mountain_stroke_width" type="float" min="0.01" max="3" appearance="full" gui-text="Épaisseur des plis montagne">0.1</param>
            <param name="mountain_stroke_color" type="color" gui-text="Couleur des plis montagne :">4278190335</param>
        </page>
        <page name="valleys" gui-text="Plis vallée">
            <param name="valley_bool" type="bool" gui-text="Dessiner les plis vallée ?">true</param>
            <param name="valley_bool_only" type="bool" gui-text="Dessiner SEULEMENT les plis vallée ?">false</param>
            <param name="valley_dashes_bool" type="bool" gui-text="Contours en pointillés ?">true</param>
            <param name="valley_dashes_len" type="float" min="0.1" max="10" appearance="full" precision="2" gui-text="Plis vallée : longueur tiret + espace">1</param>
            <param name="valley_dashes_duty" type="float" min="0.1" max="1" appearance="full" precision="2" gui-text="Plis vallée : part du tiret">0.25</param>
            <param name="valley_stroke_width" type="float" min="0.01" max="3" appearance="full" gui-text="Épaisseur des plis vallée">0.1</param>
            <param name="valley_stroke_color" type="color" gui-text="Couleur des plis vallée :">65535</param>
        </page>
        <page name="edge" gui-text="Bord">
            <param name="edge_bool" type="bool" gui-text="Dessiner les bords ?">true</param>
            <param name="edge_bool_only" type="bool" gui-text="Dessiner SEULEMENT les bords ?">false</param>
            <param name="edge_single_path" type="bool" gui-text="Bords en un seul chemin ?">true</param>
            <param name="edge_dashes_bool" type="bool" gui-text="Contours en pointillés ?">false</param>
            <param name="edge_dashes_len" type="float" min="0.1" max="10" appearance="full" precision="2" gui-text="Bords : longueur tiret + espace">1</param>
            <param name="edge_dashes_duty" type="float" min="0.1" max="1" appearance="full" precision="2" gui-text="Bords : part du tiret">0.25</param>
            <param name="edge_stroke_width" type="float" min="0.01" max="3" appearance="full" gui-text="Épaisseur des bords">0.1</param>
            <param name="edge_stroke_color" type="color" gui-text="Couleur des bords :">255</param>
        </page>
        <page name="vertices" gui-text="Sommets">
            <param name="vertex_bool" type="bool" gui-text="Dessiner les sommets ?">true</param>
            <param name="vertex_bool_only" type="bool" gui-text="Dessiner SEULEMENT les sommets ?">false</param>
            <param name="vertex_radius" type="float" min="0.01" max="50" appearance="full" gui-text="Rayon des sommets">0.1</param>
            <param name="vertex_stroke_width" type="float" min="0.01" max="3" appearance="full" gui-text="Épaisseur du contour des sommets">0.1</param>
            <param name="vertex_stroke_color" type="color" gui-text="Couleur des sommets :">255</param>
        </page>
    </param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Papier et origami"><submenu name="Origami" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">OrigamiPatterns/Cylindrical_Kresling.py</command>
    </script>
</inkscape-extension>