<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
<name>Rangement de pots (PaintStorage)</name>
<id>info.festi.boxes.py.PaintStorage</id>
<param name="generator" type="string" gui-hidden="true">paintstorage</param>
<param name="tab" type="notebook"><page name="tab_0" gui-text="Rangement de pots"><param name="x" type="float" precision="2" max="9999" gui-text="x" gui-description="largeur intérieure en mm">100</param>
<param name="y" type="float" precision="2" max="9999" gui-text="y" gui-description="profondeur intérieure en mm">300</param>
<param name="canheight" type="int" max="9999" gui-text="hauteur pot" gui-description="Hauteur des pots ou des cannettes">50</param>
<param name="candiameter" type="int" max="9999" gui-text="diamètre pot" gui-description="Diamètre des pots ou des cannettes">30</param>
<param name="minspace" type="int" max="9999" gui-text="espace min" gui-description="Espace minimal entre pots">10</param>
<param name="additional_bottom" type="bool" gui-text="additional_bottom" gui-description="Fond supplémentaire avec des trous où passent les pots de peinture">false</param>
<param name="additional_top" type="bool" gui-text="additional_top" gui-description="Plateau supérieur supplémentaire avec des trous où passent les pots de peinture">false</param>
<param name="hexpattern" type="bool" gui-text="hex" gui-description="Utiliser un arragement hexagonal pour les pots plutôt qu'à angle droit">false</param>
<param name="drawer" type="bool" gui-text="tiroir" gui-description="Créer plutôt un tiroir empilable">false</param>
</page>
<page name="tab_1" gui-text="Par défaut"><param name="thickness" type="float" precision="2" max="9999" gui-text="épaisseur" gui-description="épaisseur du matériau (en mm) [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#thickness)">3.0</param>
<param name="tabs" type="float" precision="2" max="9999" gui-text="brides" gui-description="largeur des attaches qui retiennent les pièces dans la plaque (en mm) (pas partout) [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#tabs)">0.0</param>
<param name="qr_code" type="bool" gui-text="qr_code" gui-description="Ajouter un QR code avec le lien ou la ligne de commande au résultat">false</param>
<param name="debug" type="bool" gui-text="débogage" gui-description="dessiner les boîtes englobantes de certaines structures [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#debug)">false</param>
<param name="labels" type="bool" gui-text="étiquettes" gui-description="étiqueter les pièces (si possible)">true</param>
<param name="reference" type="float" precision="2" max="9999" gui-text="référence" gui-description="dessiner un rectangle de référence de la longueur donnée (en mm) (0 pour désactiver) [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#reference)">100.0</param>
<param name="inner_corners" type="optiongroup" appearance="combo" gui-text="inner_corners" gui-description="style des angles intérieurs [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#inner-corners)">
<option value="loop">boucle</option>
<option value="corner">angle</option>
<option value="backarc">arc inversé</option>
    </param>
<param name="burn" type="float" precision="2" max="9999" gui-text="brûlage" gui-description="correction de brûlure (en mm) (plus grand = assemblage plus serré) [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#burn)">0.1</param>
</page>
<page name="tab_2" gui-text="Assemblages à entures"><param name="FingerJoint_style" type="optiongroup" appearance="combo" gui-text="style" gui-description="style des entures">
<option value="rectangular">rectangulaire</option>
<option value="springs">ressorts</option>
<option value="barbs">crans</option>
<option value="snap">clipsable</option>
    </param>
<param name="FingerJoint_surroundingspaces" type="float" precision="2" max="9999" gui-text="espaces autour" gui-description="espace au début et à la fin, en multiple des espaces normaux">2.0</param>
<param name="FingerJoint_bottom_lip" type="float" precision="2" max="9999" gui-text="bottom_lip" gui-description="hauteur des lèvres inférieures qui dépassent (multiples de l'épaisseur), FingerHoleEdge seulement !">0.0</param>
<param name="FingerJoint_edge_width" type="float" precision="2" max="9999" gui-text="largeur de bord" gui-description="espace sous les trous du FingerHoleEdge (multiples de l'épaisseur)">1.0</param>
<param name="FingerJoint_extra_length" type="float" precision="2" max="9999" gui-text="extra_length" gui-description="matière en plus à poncer pour enlever les traces de brûlure (multiples de l'épaisseur)">0.0</param>
<param name="FingerJoint_finger" type="float" precision="2" max="9999" gui-text="créneau" gui-description="largeur des entures (multiples de l'épaisseur)">2.0</param>
<param name="FingerJoint_play" type="float" precision="2" max="9999" gui-text="jeu" gui-description="espace en plus pour que les entures entrent et sortent (multiples de l'épaisseur)">0.0</param>
<param name="FingerJoint_space" type="float" precision="2" max="9999" gui-text="espace" gui-description="espace entre les entures (multiples de l'épaisseur)">2.0</param>
<param name="FingerJoint_width" type="float" precision="2" max="9999" gui-text="largeur" gui-description="largeur des trous d'entures (multiples de l'épaisseur)">1.0</param>
</page>
<page name="tab_3" gui-text="Bords empilables"><param name="Stackable_angle" type="int" max="9999" gui-text="angle" gui-description="angle intérieur des pieds">60</param>
<param name="Stackable_bottom_stabilizers" type="float" precision="2" max="9999" gui-text="bottom_stabilizers" gui-description="hauteur des bandes à coller à l'intérieur des bords du bas (multiples de l'épaisseur)">0.0</param>
<param name="Stackable_height" type="float" precision="2" max="9999" gui-text="hauteur" gui-description="hauteur des pieds (multiples de l'épaisseur)">2.0</param>
<param name="Stackable_holedistance" type="float" precision="2" max="9999" gui-text="distance des trous" gui-description="distance entre les trous d'entures et le bord du bas (multiples de l'épaisseur)">1.0</param>
<param name="Stackable_width" type="float" precision="2" max="9999" gui-text="largeur" gui-description="largeur des pieds (multiples de l'épaisseur)">4.0</param>
</page>
<page name="tab_4" gui-text="Exemple">
<image>./PaintStorage-thumb.jpg</image>
</page>
</param>
<label appearance="url">https://boxes.hackerspace-bamberg.de/PaintStorage</label>
<effect>
    <object-type>all</object-type>
    <effects-menu>
        <submenu name="FabLab Boc@l"><submenu name="Boîtes (Boxes.py)"><submenu name="Étagères et rangements" /></submenu></submenu></effects-menu>
    <icon>PaintStorage-thumb.svg</icon>
</effect>
<script>
    <command location="inx" interpreter="python">boxes_proxy.py</command>
</script>
</inkscape-extension>