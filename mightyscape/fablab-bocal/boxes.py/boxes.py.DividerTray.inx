<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
<name>Bac à séparations (DividerTray)</name>
<id>info.festi.boxes.py.DividerTray</id>
<param name="generator" type="string" gui-hidden="true">dividertray</param>
<param name="tab" type="notebook"><page name="tab_0" gui-text="Bac à séparations"><param name="sx" type="string" gui-text="sx" gui-description="sections de gauche à droite en mm [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#section-parameters)">50*3</param>
<param name="sy" type="string" gui-text="sy" gui-description="sections de l'arrière à l'avant en mm [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#section-parameters)">50*3</param>
<param name="h" type="float" precision="2" max="9999" gui-text="h" gui-description="hauteur interieure en mm (si on ne choisit pas « extérieur »)">100.0</param>
<param name="outside" type="bool" gui-text="extérieur" gui-description="les dimensions sont des mesures extérieures [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#outside)">true</param>
<param name="notches_in_wall" type="bool" gui-text="notches_in_wall" gui-description="faire sur les parois les mêmes encoches que sur les séparations">true</param>
<param name="left_wall" type="bool" gui-text="left_wall" gui-description="créer la paroi gauche">true</param>
<param name="right_wall" type="bool" gui-text="right_wall" gui-description="créer la paroi droite">true</param>
<param name="bottom" type="bool" gui-text="fond" gui-description="créer la paroi du bas">false</param>
<param name="handle" type="bool" gui-text="poignée" gui-description="ajouter une poignée en bas">false</param>
</page>
<page name="tab_1" gui-text="Par défaut"><param name="thickness" type="float" precision="2" max="9999" gui-text="épaisseur" gui-description="épaisseur du matériau (en mm) [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#thickness)">3.0</param>
<param name="tabs" type="float" precision="2" max="9999" gui-text="brides" gui-description="largeur des attaches qui retiennent les pièces dans la plaque (en mm) (pas partout) [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#tabs)">0.0</param>
<param name="qr_code" type="bool" gui-text="qr_code" gui-description="Ajouter un QR code avec le lien ou la ligne de commande au résultat">false</param>
<param name="debug" type="bool" gui-text="débogage" gui-description="dessiner les boîtes englobantes de certaines structures [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#debug)">false</param>
<param name="labels" type="bool" gui-text="étiquettes" gui-description="étiqueter les pièces (si possible)">true</param>
<param name="reference" type="float" precision="2" max="9999" gui-text="référence" gui-description="dessiner un rectangle de référence de la longueur donnée (en mm) (0 pour désactiver) [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#reference)">100.0</param>
<param name="inner_corners" type="optiongroup" appearance="combo" gui-text="inner_corners" gui-description="style des angles intérieurs [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#inner-corners)">
<option value="loop">boucle</option>
<option value="corner">angle</option>
<option value="backarc">arc inversé</option>
    </param>
<param name="burn" type="float" precision="2" max="9999" gui-text="brûlage" gui-description="correction de brûlure (en mm) (plus grand = assemblage plus serré) [🛈](https://florianfesti.github.io/boxes/html/usermanual.html#burn)">0.1</param>
</page>
<page name="tab_2" gui-text="Assemblages à entures"><param name="FingerJoint_style" type="optiongroup" appearance="combo" gui-text="style" gui-description="style des entures">
<option value="rectangular">rectangulaire</option>
<option value="springs">ressorts</option>
<option value="barbs">crans</option>
<option value="snap">clipsable</option>
    </param>
<param name="FingerJoint_surroundingspaces" type="float" precision="2" max="9999" gui-text="espaces autour" gui-description="espace au début et à la fin, en multiple des espaces normaux">2.0</param>
<param name="FingerJoint_bottom_lip" type="float" precision="2" max="9999" gui-text="bottom_lip" gui-description="hauteur des lèvres inférieures qui dépassent (multiples de l'épaisseur), FingerHoleEdge seulement !">0.0</param>
<param name="FingerJoint_edge_width" type="float" precision="2" max="9999" gui-text="largeur de bord" gui-description="espace sous les trous du FingerHoleEdge (multiples de l'épaisseur)">1.0</param>
<param name="FingerJoint_extra_length" type="float" precision="2" max="9999" gui-text="extra_length" gui-description="matière en plus à poncer pour enlever les traces de brûlure (multiples de l'épaisseur)">0.0</param>
<param name="FingerJoint_finger" type="float" precision="2" max="9999" gui-text="créneau" gui-description="largeur des entures (multiples de l'épaisseur)">2.0</param>
<param name="FingerJoint_play" type="float" precision="2" max="9999" gui-text="jeu" gui-description="espace en plus pour que les entures entrent et sortent (multiples de l'épaisseur)">0.0</param>
<param name="FingerJoint_space" type="float" precision="2" max="9999" gui-text="espace" gui-description="espace entre les entures (multiples de l'épaisseur)">2.0</param>
<param name="FingerJoint_width" type="float" precision="2" max="9999" gui-text="largeur" gui-description="largeur des trous d'entures (multiples de l'épaisseur)">1.0</param>
</page>
<page name="tab_3" gui-text="Bord à poignée"><param name="HandleEdge_height" type="float" precision="2" max="9999" gui-text="hauteur" gui-description="hauteur au-dessus de la paroi en mm">20.0</param>
<param name="HandleEdge_hole_height" type="float" precision="2" max="9999" gui-text="hole_height" gui-description="hauteur du ou des trous en pourcentage de la hauteur maximale (hauteur de poignée - 2 × épaisseur du matériau)">75.0</param>
<param name="HandleEdge_hole_width" type="string" gui-text="hole_width" gui-description="largeur du ou des trous en pourcentage de la largeur maximale (largeur du bord - (n+1) × épaisseur du matériau)">40:40</param>
<param name="HandleEdge_on_sides" type="bool" gui-text="on_sides" gui-description="si coché, ajouté aux côtés, sinon à l'avant et à l'arrière (seulement avec le paramètre top_edge)">true</param>
<param name="HandleEdge_radius" type="float" precision="2" max="9999" gui-text="rayon" gui-description="rayon des coins en mm">10.0</param>
<param name="HandleEdge_outset" type="float" precision="2" max="9999" gui-text="débord" gui-description="prolonger la poignée sur la longueur du bord (multiples de l'épaisseur)">1.0</param>
</page>
<page name="tab_4" gui-text="le couvercle"><param name="Lid_handle" type="optiongroup" appearance="combo" gui-text="poignée" gui-description="type de poignée">
<option value="none">aucun</option>
<option value="long_rounded">long_rounded</option>
<option value="long_trapezoid">long_trapezoid</option>
<option value="long_doublerounded">long_doublerounded</option>
<option value="knob">bouton</option>
    </param>
<param name="Lid_style" type="optiongroup" appearance="combo" gui-text="style" gui-description="type de couvercle à créer">
<option value="none">aucun</option>
<option value="flat">plat</option>
<option value="chest">coffre</option>
<option value="overthetop">par-dessus</option>
<option value="ontop">posé dessus</option>
    </param>
<param name="Lid_handle_height" type="float" precision="2" max="9999" gui-text="handle_height" gui-description="hauteur de la poignée (si applicable)">8.0</param>
<param name="Lid_height" type="float" precision="2" max="9999" gui-text="hauteur" gui-description="hauteur du rebord (le cas échéant)">4.0</param>
<param name="Lid_play" type="float" precision="2" max="9999" gui-text="jeu" gui-description="jeu pour faire glisser le couvercle (si applicable)">0.1</param>
</page>
<page name="tab_5" gui-text="Rainures des séparations"><param name="Slot_angle" type="int" max="9999" gui-text="angle" gui-description="angle des rainures, en degrés. 0° = vertical.">0</param>
<param name="Slot_depth" type="int" max="9999" gui-text="profondeur" gui-description="profondeur de la rainure en mm">20</param>
<param name="Slot_extra_slack" type="float" precision="2" max="9999" gui-text="extra_slack" gui-description="jeu en plus (en plus de l'épaisseur et du trait de coupe) pour insérer les séparations, en mm">0.2</param>
<param name="Slot_radius" type="int" max="9999" gui-text="rayon" gui-description="rayon de l'entrée de la rainure en mm">2</param>
</page>
<page name="tab_6" gui-text="Encoches des séparations"><param name="Notch_depth" type="int" max="9999" gui-text="profondeur" gui-description="profondeur">15</param>
<param name="Notch_lower_radius" type="int" max="9999" gui-text="lower_radius" gui-description="lower_radius">8</param>
<param name="Notch_upper_radius" type="int" max="9999" gui-text="upper_radius" gui-description="upper_radius">1</param>
</page>
<page name="tab_7" gui-text="Séparations"><param name="Divider_bottom_margin" type="int" max="9999" gui-text="bottom_margin" gui-description="marge entre le fond de la boîte et celui des séparations, en mm">0</param>
<param name="Divider_play" type="float" precision="2" max="9999" gui-text="jeu" gui-description="jeu pour éviter qu'elles se bloquent contre les parois (multiples de l'épaisseur)">0.05</param>
</page>
<page name="tab_8" gui-text="Exemple">
<image>./DividerTray-thumb.jpg</image>
</page>
</param>
<label appearance="url">https://boxes.hackerspace-bamberg.de/DividerTray</label>
<effect>
    <object-type>all</object-type>
    <effects-menu>
        <submenu name="FabLab Boc@l"><submenu name="Boîtes (Boxes.py)"><submenu name="Plateaux et casiers" /></submenu></submenu></effects-menu>
    <icon>DividerTray-thumb.svg</icon>
</effect>
<script>
    <command location="inx" interpreter="python">boxes_proxy.py</command>
</script>
</inkscape-extension>