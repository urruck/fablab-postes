<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Dupliquer + inverser + joindre</name>
    <id>fablabchemnitz.de.duplicate_reverse_join</id>
    <effect>
        <object-type>path</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Chemins"><submenu name="Joindre et ordonner" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">duplicate_reverse_join.py</command>
    </script>
</inkscape-extension>