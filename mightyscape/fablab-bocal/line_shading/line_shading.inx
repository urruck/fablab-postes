<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Ombrage par lignes</name>
    <id>fablabchemnitz.de.line_shading</id>
    <param name="active-tab" type="notebook">
        <page name="Options" gui-text="Options">
            <param name="waveform" type="optiongroup" appearance="combo" gui-text="Forme d'onde">
                <option value="sin">Sinusoïdale</option>
                <option value="saw">Onde triangulaire</option>
                <option value="square">Onde carrée</option>
            </param>
            <param name="num_lines" type="int" min="1" max="1000000000" gui-text="Nombre de lignes :">20</param>
            <param name="min_period" type="float" min="0.05" max="1000000000" precision="2" gui-text="Période min :">0.1</param>
            <param name="max_period" type="float" min="0.05" max="1000000000" precision="2" gui-text="Période max :">2.0</param>
            <param name="min_amplitude" type="float" min="0.0" max="1000000000" precision="2" gui-text="Amplitude min :">0.0</param>
            <param name="max_amplitude" type="float" min="0.0" max="1000000000" precision="2" gui-text="Amplitude max :">1.0</param>
            <param name="gamma" type="float" min="0.1" max="10.0" precision="2" gui-text="Gamma :">2.2</param>
        </page>
        <page name="Help" gui-text="Aide">
            <label>Cette extension convertit l'image sélectionnée en ombrage ondulé.</label>
        </page>
    </param>
    <param name="line_width" type="float" min="0.01" max="1000" precision="2" gui-text="Épaisseur de ligne :">0.25</param>
    <param name="units" type="optiongroup" appearance="combo" gui-text=" ">
        <option value="mm">mm</option>
        <option value="px">px</option>
        <option value="pt">pt</option>
        <option value="pc">pc</option>
        <option value="in">in</option>
    </param>
    <param name="remove" type="bool" gui-text="Supprimer l'image">false</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Images et vectorisation" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">line_shading.py</command>
    </script>
</inkscape-extension>