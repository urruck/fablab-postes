<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Remplacer couleur et opacité</name>
    <id>fablabchemnitz.de.replace_color_and_alpha</id>
    <param name="from_color" type="string" max_length="8" gui-text="Remplacer la couleur (RRVVBB et AA facultatif) : #">000000</param>
    <param name="to_color" type="string" max_length="8" gui-text="Par la couleur (RRVVBBAA) : #">000000</param>
    <effect needs-document="true">
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Couleurs" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">replace_color_and_alpha.py</command>
    </script>
</inkscape-extension>