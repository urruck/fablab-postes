<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Vektorkollektor</name>
    <id>fablabchemnitz.de.vektorkollektor</id>
    <param name="tab" type="notebook">
        <page name="tab_settings" gui-text="Paramètres">
            <label appearance="header">Vektorkollektor - dessins des habitants de Chemnitz ;-)</label>
            <image>SonnenzeichenVektorskop/SonnenzeichenVektorskop.svg</image>  
            <label appearance="header">Source</label>
            <param name="download_or_local" gui-text="Entrée" type="optiongroup" appearance="radio">
                <option value="remote">Télécharger le fichier vektorkollektor.js récent depuis l'adresse indiquée</option>
                <option value="local">Utiliser un fichier local au chemin indiqué</option>
            </param>
            <param name="vk_url" type="string" gui-text="Adresse des données" gui-description="par défaut : http://www.vektorkollektor.com/vektordaten/vektorkollektor_optimized.js">http://www.vektorkollektor.com/vektordaten/vektorkollektor_optimized.js</param>
            <param name="vk_inputfile" type="path" gui-text="Fichier local (*.js)" gui-description="Chemin complet du fichier Vektorkollektor *.js brut" filetypes="js" mode="file">C:\Users\</param>
            <param name="showinfo" type="bool" gui-text="Afficher des informations supplémentaires">false</param>
            <label appearance="header">Identifiant Vektorkollektor</label>
            <param name="vk_id" type="int" gui-text="Numéro" min="0" max="99999" gui-description="Identifiant du dessin Vektorkollektor voulu">0</param>
            <label appearance="header">Aides</label>
            <label>Info : tous les dessins Vektorkollektor sont dans le domaine public</label>
            <label appearance="url">http://www.vektorkollektor.com</label>
            <label appearance="url">http://www.vektorkollektor.com/vektordaten/vektorkollektor.pdf</label>
            <label appearance="url">http://www.vektorkollektor.com/vektordaten/vektorkollektor.js</label>
            <label appearance="url">http://www.vektorkollektor.com/vektordaten/vektorkollektor_optimized.js</label>
        </page>
        <page name="tab_about" gui-text="À propos">
            <label appearance="header">Vektorkollektor</label>
            <label>Cette extension génère du SVG à partir de données plt.</label>
            <label>2021 - 2023 / écrit par Mario Voigt (Stadtfabrikanten e.V. / FabLab Chemnitz)</label>
            <spacer />
            <label appearance="header">Documentation en ligne</label>
            <label appearance="url">https://y.stadtfabrikanten.org/vektorkollektor</label>
            <spacer />
            <label appearance="header">Contribuer</label>
            <label appearance="url">https://gitea.fablabchemnitz.de/FabLab_Chemnitz/mightyscape-1.2</label>
            <label appearance="url">mailto:mario.voigt@stadtfabrikanten.org</label>
            <spacer />
            <label appearance="header">Collection d'extensions MightyScape</label>
            <label>Ce logiciel fait partie de la collection d'extensions MightyScape pour Inkscape, sous licence GNU GPL v3</label>
            <label appearance="url">https://y.stadtfabrikanten.org/mightyscape-overview</label>
        </page>
        <page name="tab_donate" gui-text="Faire un don">
            <label appearance="header">Café + pizza</label>
            <label>Nous sommes les Stadtfabrikanten, qui font vivre le FabLab Chemnitz depuis 2016. Un FabLab est un atelier ouvert qui donne accès à des machines et des outils numériques : imprimantes 3D, découpeuses laser, fraiseuses CNC.</label>
            <spacer />           
            <label>Vous aimez notre travail et voulez nous soutenir ? Vous pouvez faire un don à notre association de différentes façons :</label>
            <label appearance="url">https://y.stadtfabrikanten.org/donate</label>
            <spacer />
            <label>Merci d'utiliser notre extension et de nous aider !</label>
            <image>../000_about_fablabchemnitz.svg</image>
        </page>
    </param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Formes et motifs"><submenu name="Générateurs" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">vektorkollektor.py</command>
    </script>
</inkscape-extension>