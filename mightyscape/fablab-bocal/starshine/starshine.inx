<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Rayonnement d'étoile</name>
    <id>fablabchemnitz.de.starshine</id>
    <param name="r1" type="int" min="1" max="50" gui-text="Rayon intérieur (min)">10</param>
    <param name="r2" type="int" min="1" max="50" gui-text="Rayon intérieur (max)">10</param>
    <separator />
    <param name="R1" type="int" min="100" max="500" gui-text="Rayon extérieur (min)">350</param>
    <param name="R2" type="int" min="100" max="500" gui-text="Rayon extérieur (max)">350</param>
    <separator />
    <param name="a1" type="int" min="1" max="20" gui-text="Angle (min)">4</param>
    <param name="a2" type="int" min="1" max="20" gui-text="Angle (max)">10</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Formes et motifs"><submenu name="Textures et effets" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">starshine.py</command>
    </script>
</inkscape-extension>