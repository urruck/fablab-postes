<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
   <name>Spirale d'Archimède</name>
   <id>fablabchemnitz.de.archimedes_spiral</id>
    <param name="tab" type="notebook">
        <page name="tab_settings" gui-text="Paramètres">
           <label appearance="header">R = r + aθ</label>
           <param name="th" type="float" min="0.00" max="360.00" gui-text="angle (°)" gui-description="Angle de départ">0</param>
           <param name="r" type="int" min="0" max="1000000" gui-text="r (mm)">50</param>
           <param name="a" type="float" min="0" max="1000000" gui-text="a">3</param>
           <param name="step" type="int" min="1" max="300" gui-text="Pas" gui-description="Plus la valeur est élevée, meilleure est la précision. Avec un pas très faible, la longueur obtenue ne sera pas précise et la courbe risque de ne pas être dessinée du tout">50</param>
           <param name="trl" type="optiongroup" appearance="combo" gui-text="Sens de rotation">
              <option value="0">Gauche</option>
              <option value="1">Droite</option>
           </param>
           <param name="length" type="float" min="0" max="1000000" gui-text="Longueur (mm)">0</param>
           <param name="turns" type="int" min="1" max="1000000" gui-text="Tours" gui-description="Fonctionne seulement si « Longueur (mm) » vaut 0.0">5</param>
           <param name="modifier" type="int" min="0" max="1000000" gui-text="Modificateur" gui-description="À tester pour créer des effets artistiques">0</param>
        </page>
        <page name="tab_about" gui-text="À propos">
            <label appearance="header">Spirale d'Archimède</label>
            <label>2020 - 2025 / écrit par Mario Voigt (Stadtfabrikanten e.V. / FabLab Chemnitz)</label>
            <spacer />
            <label appearance="header">Documentation en ligne</label>
            <label appearance="url">https://y.stadtfabrikanten.org/archimedesspiral</label>
            <spacer />
            <label appearance="header">Contribuer</label>
            <label appearance="url">https://gitea.fablabchemnitz.de/FabLab_Chemnitz/mightyscape-1.2</label>
            <label appearance="url">mailto:mario.voigt@stadtfabrikanten.org</label>
            <spacer />
            <label appearance="header">Collection d'extensions MightyScape</label>
            <label>Ce logiciel fait partie de la collection d'extensions MightyScape pour Inkscape, sous licence GNU GPL v3</label>
            <label appearance="url">https://y.stadtfabrikanten.org/mightyscape-overview</label>
        </page>
        <page name="tab_donate" gui-text="Faire un don">
            <label appearance="header">Café + pizza</label>
            <label>Nous sommes les Stadtfabrikanten, qui font vivre le FabLab Chemnitz depuis 2016. Un FabLab est un atelier ouvert qui donne accès à des machines et des outils numériques : imprimantes 3D, découpeuses laser, fraiseuses CNC.</label>
            <spacer />           
            <label>Vous aimez notre travail et voulez nous soutenir ? Vous pouvez faire un don à notre association de différentes façons :</label>
            <label appearance="url">https://y.stadtfabrikanten.org/donate</label>
            <spacer />
            <label>Merci d'utiliser notre extension et de nous aider !</label>
            <image>../000_about_fablabchemnitz.svg</image>
        </page>
    </param>
   <effect>
      <object-type>all</object-type>
      <effects-menu>
         <submenu name="FabLab Boc@l"><submenu name="Formes et motifs"><submenu name="Générateurs" /></submenu></submenu></effects-menu>
       <menu-tip>The extension draws a spiral by a lot of fine-grained line segments.</menu-tip>
       <icon>icon.svg</icon>
   </effect>
   <script>
      <command location="inx" interpreter="python">archimedes_spiral.py</command>
   </script>
</inkscape-extension>