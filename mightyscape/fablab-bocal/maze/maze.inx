<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Labyrinthe</name>
    <id>fablabchemnitz.de.maze</id>
    <param name="verti" type="int" min="2" max="1000" gui-text="Hauteur (cases)">20</param>
    <param name="horiz" type="int" min="2" max="1000" gui-text="Longueur (cases)">20</param>
    <param name="size" type="float" max="100.0" gui-text="Taille des cases">10.0</param>
     <param name="cell_units" gui-text="Unité des cases" type="optiongroup" appearance="combo">
        <option value="px">px</option>
        <option value="pt">pt</option>
        <option value="in">in</option>
        <option value="cm">cm</option>
        <option value="mm">mm</option>
     </param>
    <param name="width" type="float" gui-text="Épaisseur de ligne">1.0</param>
    <param name="algo" type="optiongroup" appearance="combo" gui-text="Algorithme">
        <option value="kruskal">Kruskal</option>
        <option value="recursive_backtrack">Retour sur trace récursif</option>
        <option value="empty">Vide</option>
        <option value="full">Plein</option>
    </param>
    <label>Ce script génère un labyrinthe selon l'algorithme choisi.</label>
    <effect>
        <object-type>path</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Jeux et puzzles" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">maze.py</command>
    </script>
</inkscape-extension>