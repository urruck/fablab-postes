<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Parabole 2</name>
    <id>fablabchemnitz.de.parabola_2</id>
    <param name="length" type="int" min="1" max="10000" gui-text="Longueur du côté :">200</param>
    <param name="segments" type="int" min="5" max="1000" gui-text="Nombre de segments :">25</param>
    <param name="shape" type="optiongroup" appearance="combo" gui-text="Choisir une forme :">
        <option value="triangle">Triangle</option>
        <option value="square">Carré</option>
        <option value="pentagon">Pentagone</option>
        <option value="hexagon">Hexagone</option>
        <option value="septagon">Heptagone</option>
        <option value="octagon">Octogone</option>
    </param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Formes et motifs"><submenu name="Générateurs" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">parabola_2.py</command>
    </script>
</inkscape-extension>