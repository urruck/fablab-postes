<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Définir le matériau optique</name>
    <id>fablabchemnitz.de.raytracing.set_lens_material</id>
    <param name="optical_material" type="optiongroup" appearance="combo" gui-text="Choisir le matériau :">
        <option value="none">Aucun</option>
        <option value="beam">Faisceau</option>
        <option value="mirror">Miroir</option>
        <option value="beam_dump">Absorbeur de faisceau</option>
        <option value="beam_splitter">Séparateur de faisceau</option>
        <option value="glass">Verre</option>
    </param>
    <param name="optical_index" type="float" min="1.0000" max="3.0000" precision="4" gui-text="Indice optique :" indent="2">1.5168</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Divers"><submenu name="Optique" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">set_material.py</command>
    </script>
</inkscape-extension>