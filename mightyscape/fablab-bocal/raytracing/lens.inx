<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Insérer une lentille optique</name>
    <id>fablabchemnitz.de.raytracing_insert_lens_optics</id>
    <param name="focal_length" type="float" gui-text="Distance focale :" min="-10000." max="10000." precision="3">100.</param>
    <param name="focal_length_unit" type="optiongroup" appearance="combo" gui-text=" ">
        <option value="mm">mm</option>
        <option value="cm">cm</option>
        <option value="in">in</option>
    </param>
    <param name="diameter" type="float" gui-text="Diamètre :" min="0" max="10000" precision="3">1</param>
    <param name="diameter_unit" type="optiongroup" appearance="combo" gui-text=" ">
        <option value="in">in</option>
        <option value="mm">mm</option>
        <option value="cm">cm</option>
    </param>
    <param name="edge_thickness" type="float" gui-text="Épaisseur au bord :" min="0" max="10000" precision="3">2</param>
    <param name="edge_thickness_unit" type="optiongroup" appearance="combo" gui-text=" ">
        <option value="mm">mm</option>
        <option value="in">in</option>
        <option value="cm">cm</option>
    </param>
    <param name="optical_index" type="float" min="1." max="3." precision="4" gui-text="Indice optique :">1.5168</param>
    <param name="lens_type" type="optiongroup" appearance="combo" gui-text="Type de lentille :">
        <option value="plano_con">Plan-concave / convexe</option>
        <option value="bi_con">Biconcave / convexe</option>
    </param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Divers"><submenu name="Optique" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">lens.py</command>
    </script>
</inkscape-extension>