<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Motif guilloché</name>
    <id>fablabchemnitz.de.guilloche_creations.guilloche_pattern</id>
    <param name="patternFunction" type="optiongroup" appearance="combo" gui-text="Fonction">
        <option value="line">Ligne</option>
        <option value="sin">Sin</option>
        <option value="cos">Cos</option>
        <option value="env1">Env1</option>
        <option value="env2">Env2</option>
        <option value="env3">Env3</option>
        <option value="env4">Env4</option>
        <option value="env5">Env5</option>
        <option value="env6">Env6</option>
        <option value="env7">Env7</option>
        <option value="env8">Env8</option>
        <option value="env9">Env9</option>
        <option value="env10">Env10</option>
        <option value="env11">Env11</option>
        <option value="env12">Env12</option>
    </param>
    <param name="tab" type="notebook">
        <page name="pattern" gui-text="Motif">
            <param name="frequency" type="int" min="1" max="100" gui-text="Fréquence :">10</param>
            <param name="amplitude" type="int" min="-300" max="300" gui-text="Amplitude :">100</param>
            <param name="phaseOffset" type="int" min="-100" max="100" gui-text="Déphasage :">0</param>
            <param name="offset" type="int" min="-100" max="100" gui-text="Décalage :">0</param>
            <param name="phaseCoverage" type="int" min="-100" max="100" gui-text="Couverture de phase">100</param>
            <param name="series" type="int" min="1" max="50" gui-text="Série">1</param>
            <param name="nodes" type="int" min="2" max="1000" gui-text="Nombre de nœuds :">20</param>
            <param name="remove" type="bool" gui-text="Supprimer les objets de contrôle">false</param>
            <param name="strokeColor" type="color" gui-text="Couleur du contour" />
        </page>
        <page name="function" gui-text="Fonction">
            <param name="amplitude1" type="float" min="-10.0" max="10.0" precision="2" gui-text="Amplitude 1 :">0.0</param>
            <param name="phase1" type="int" min="-100" max="100" gui-text="Déphasage 1 :">0</param>
            <param name="amplitude2" type="float" min="-10.0" max="10.0" precision="2" gui-text="Amplitude 2 :">0.0</param>
            <param name="phase2" type="int" min="-100" max="100" gui-text="Déphasage 2 :">0</param>
            <param name="amplitude3" type="float" min="-10.0" max="10.0" precision="2" gui-text="Amplitude 3 :">0.0</param>
            <param name="phase3" type="int" min="-100" max="100" gui-text="Déphasage 3 :">0</param>
            <param name="amplitude4" type="float" min="-10.0" max="10.0" precision="2" gui-text="Amplitude 4 :">0.0</param>
            <param name="phase4" type="int" min="-100" max="100" gui-text="Déphasage 4 :">0</param>
            <param name="amplitude5" type="float" min="-10.0" max="10.0" precision="2" gui-text="Amplitude 5 :">0.0</param>
            <param name="phase5" type="int" min="-100" max="100" gui-text="Déphasage 5 :">0</param>
        </page>
    </param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Chemins"><submenu name="Modifier" /></submenu></submenu></effects-menu>            
    </effect>
    <script>
        <command location="inx" interpreter="python">guilloche_pattern.py</command>
    </script>
</inkscape-extension>