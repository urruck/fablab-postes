<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Styles vers calques</name>
    <id>fablabchemnitz.de.styles_to_layers</id>
    <param name="tab" type="notebook">
        <page name="tab_settings" gui-text="Paramètres">
            <param name="separateby" gui-text="Séparer par" type="optiongroup" appearance="combo">
               <option value="element_tag">Type d'élément</option>
               <option value="stroke">Couleur du contour</option>
               <option value="stroke_width">Épaisseur du contour</option>
               <option value="stroke_hairline">Contour trait fin</option>
               <option value="stroke_opacity">Opacité du contour</option>
               <option value="fill">Couleur de remplissage</option>
               <option value="fill_opacity">Opacité du remplissage</option>
            </param>
            <param name="sortcolorby" gui-text="Trier les couleurs par" type="optiongroup" appearance="combo" gui-description="Ne s'applique qu'aux couleurs de contour et de remplissage">
               <option value="hexval">Valeur hexadécimale</option>
               <option value="hue">Teinte</option>
               <option value="saturation">Saturation</option>
               <option value="luminance">Luminance</option>
            </param>
            <param name="subdividethreshold" type="int" min="1" max="9999" gui-text="Nombre de sous-calques" gui-description="Une plage min/max de la valeur du style choisi est calculée, et vous obtenez des calques (regroupement grossier) avec des sous-calques (regroupement fin). S'il y a moins de sous-calques calculés que ce seuil, il est réduit automatiquement.">1</param>
            <param name="decimals" type="int" min="0" max="10" gui-text="Tolérance décimale" gui-description="Plus il y a de décimales, plus il y a de calques distincts. Ne s'applique qu'aux sous-calques (seuil &gt; 1)">1</param>
            <param name="apply_transformations" type="bool" gui-text="Appliquer les transformations (nécessite l'extension correspondante)" gui-description="Appelle l'extension « Appliquer les transformations ». Évite les décalages de géométrie">false</param>
            <param name="cleanup" type="bool" gui-text="Nettoyer les groupes / calques inutilisés (nécessite l'extension correspondante)" gui-description="Appelle l'extension « Supprimer les groupes vides » si elle est disponible">true</param>
            <param name="put_unfiltered" type="bool" gui-text="Mettre les éléments non filtrés dans un calque à part">false</param>
            <param name="show_info" type="bool" gui-text="Montrer les éléments sans attribut de style à filtrer">false</param>
        </page>
        <page name="tab_about" gui-text="À propos">
            <label appearance="header">Styles vers calques</label>
            <label>Cette extension range à nouveau en calques la sélection ou tout le document selon les valeurs de style (contour ou remplissage). Le filtre ne porte que sur l'attribut style des éléments, pas sur les attributs séparés « stroke » ou « fill », ni sur les classes svg:style. Utilisez l'extension « Nettoyer les styles » pour regrouper ces attributs séparés dans l'attribut style.</label>
            <label>2020 - 2023 / écrit par Mario Voigt (Stadtfabrikanten e.V. / FabLab Chemnitz)</label>
            <spacer />
            <label appearance="header">Documentation en ligne</label>
            <label appearance="url">https://y.stadtfabrikanten.org/stylestolayers</label>
            <spacer />
            <label appearance="header">Contribuer</label>
            <label appearance="url">https://gitea.fablabchemnitz.de/FabLab_Chemnitz/mightyscape-1.2</label>
            <label appearance="url">mailto:mario.voigt@stadtfabrikanten.org</label>
            <spacer />
            <label appearance="header">Collection d'extensions MightyScape</label>
            <label>Ce logiciel fait partie de la collection d'extensions MightyScape pour Inkscape, sous licence GNU GPL v3</label>
            <label appearance="url">https://y.stadtfabrikanten.org/mightyscape-overview</label>
        </page>
        <page name="tab_donate" gui-text="Faire un don">
            <label appearance="header">Café + pizza</label>
            <label>Nous sommes les Stadtfabrikanten, qui font vivre le FabLab Chemnitz depuis 2016. Un FabLab est un atelier ouvert qui donne accès à des machines et des outils numériques : imprimantes 3D, découpeuses laser, fraiseuses CNC.</label>
            <spacer />           
            <label>Vous aimez notre travail et voulez nous soutenir ? Vous pouvez faire un don à notre association de différentes façons :</label>
            <label appearance="url">https://y.stadtfabrikanten.org/donate</label>
            <spacer />
            <label>Merci d'utiliser notre extension et de nous aider !</label>
            <image>../000_about_fablabchemnitz.svg</image>
        </page>
    </param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Calques et groupes" /></submenu></effects-menu>
       <menu-tip>Re-layer your selected items or the whole document according to their color (stroke or fill). Each style will be put onto it's own layer. This way you can devide elements by their colors with ease.</menu-tip>
       <icon>icon.svg</icon>
    </effect>
    <script>
        <command location="inx" interpreter="python">styles_to_layers.py</command>
    </script>
</inkscape-extension>