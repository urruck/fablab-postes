<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Ouvrir le dossier du fichier actuel</name>
    <id>fablabchemnitz.de.open_currentfile_dir</id>
    <effect needs-live-preview="false">
        <object-type>all</object-type>
		<effects-menu>
         <submenu name="FabLab Boc@l"><submenu name="Divers" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">open_currentfile_dir.py</command>
    </script>
</inkscape-extension>