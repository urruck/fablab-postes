<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Générateur de boîte - Cône elliptique</name>
    <id>fablabchemnitz.de.box_maker_elliptical_cone</id>
    <param name="unit" type="optiongroup" appearance="combo" gui-text="Unité">
        <option value="mm">mm</option>
        <option value="cm">cm</option>
        <option value="in">in</option>
        <option value="pt">pt</option>
        <option value="px">px</option>
        <option value="pc">pc</option>
    </param>
    <param name="thickness" type="float" min="1.0" max="10.0" gui-text="Épaisseur du matériau">3.0</param>
    <param name="d1" type="float" min="30.0" max="1000.0" gui-text="Diamètre de la plus petite ellipse (grand axe)">60.0</param>
    <param name="d2" type="float" min="29.0" max="1000.0" gui-text="Diamètre de la plus grande ellipse (grand axe)">90.0</param>
    <param name="eccentricity" type="float" min="0.01" max="1.0" gui-text="Excentricité de l'ellipse, rapport petit axe / grand axe">0.5</param>
    <param name="zc" type="float" min="15.0" max="1000.0" gui-text="Hauteur du cône">50.0</param>
    <param name="notch_interval" type="int" min="2" max="10" gui-text="Intervalle entre encoches, entier en mm">2</param>
    <param name="cut_position" type="int" min="0" max="360" gui-text="Angle de la ligne de coupe, en degrés">0</param>
    <param name="inner_size" type="bool" gui-text="Dimensions intérieures">true</param>
    <param name="Mode_Debug" type="bool" gui-text="Afficher les informations de débogage">true</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Boîtes (autres modèles)"><submenu name="À encoches" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">box_maker_elliptical_cone.py</command>
    </script>
</inkscape-extension>