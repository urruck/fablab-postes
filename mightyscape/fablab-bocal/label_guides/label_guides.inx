        <page name="circ" gui-text="Préréglage (rond et ovale)">
            <param name="circ_preset" type="optiongroup" appearance="combo" gui-text="Préréglage d'étiquettes :">
                <option value="LP2_115R">Étiquettes 114,5 mm (2/feuille, A4) [LP2/115R]</option>
                <option value="LP6_88R">Étiquettes 88 mm (6/feuille, A4) [LP6/88R]</option>
                <option value="LP6_85R">Étiquettes 85 mm (6/feuille, A4) [LP6/85R]</option>
                <option value="LP6_76R">Étiquettes 76 mm (6/feuille, A4) [LP6/76R]</option>
                <option value="C2244">Étiquettes 72 mm (6/feuille, A4) [C2244, LP6/72R]</option>
                <option value="LP8_69R">Étiquettes 69 mm (8/feuille, A4) [LP8/69R]</option>
