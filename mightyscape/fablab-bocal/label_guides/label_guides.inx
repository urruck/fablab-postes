                <option value="L7780">Étiquettes 40 mm (24/feuille, A4) [L7780, LP24/40R]</option>
                <option value="LP35_37R">Étiquettes 37 mm (35/feuille, A4) [LP35/37R]</option>
                <option value="LP35_35R">Étiquettes 35 mm (35/feuille, A4) [LP35/35R]</option>
                <option value="LP40_32R">Étiquettes 32 mm (40/feuille, A4) [LP40/32R]</option>
                <option value="LP54_29R">Étiquettes 29 mm (54/feuille, A4) [LP54/29R]</option>
                <option value="LP70_25R">Étiquettes 25 mm (70/feuille, A4) [LP70/25R]</option>
                <option value="LP117_19R">Étiquettes 19 mm (117/feuille, A4) [LP117/19R]</option>
                <option value="LP216_13R">Étiquettes 13 mm (216/feuille, A4) [LP216/13R]</option>
