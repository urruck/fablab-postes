<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Repères d'étiquettes</name>
    <id>fablabchemnitz.de.label_guides</id>
    <param name="units" type="optiongroup" appearance="combo" gui-text="Unités :">
        <option value="mm">mm</option>
        <option value="in">pouce</option>
    </param>
    <param name="preset_tab" type="notebook">
        <page name="rrect" gui-text="Préréglage (rectangle arrondi)">
            <param name="rrect_preset" type="optiongroup" appearance="combo" gui-text="Préréglage d'étiquettes :">
                <option value="L7167">Étiquettes 199,6 x 289,1 mm (1/feuille, A4) [L7167, LP1/199]</option>
