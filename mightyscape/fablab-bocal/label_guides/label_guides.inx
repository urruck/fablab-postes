        </page>
        <page name="custom" gui-text="Personnalisé">
            <label appearance="header">Options d'étiquettes personnalisées</label>
            <param name="margin_l" type="float" min="0" max="1000" gui-text="Marge gauche">8.5</param>
            <param name="margin_t" type="float" min="0" max="1000" gui-text="Marge haute">13</param>
            <param name="size_x" type="float" min="0" max="1000" gui-text="Taille X de l'étiquette">37</param>
            <param name="size_y" type="float" min="0" max="1000" gui-text="Taille Y de l'étiquette">37</param>
            <param name="pitch_x" type="float" min="0" max="1000" gui-text="Pas X des étiquettes">39</param>
            <param name="pitch_y" type="float" min="0" max="1000" gui-text="Pas Y des étiquettes">39</param>
            <param name="count_x" type="int" min="0" max="1000" gui-text="Nombre en largeur">5</param>
            <param name="count_y" type="int" min="0" max="1000" gui-text="Nombre en hauteur">7</param>
            <param name="shapes" type="optiongroup" appearance="combo" gui-text="Forme des étiquettes :">
                <option value="rect">Rectangle</option>
                <option value="circle">Cercle / ellipse</option>
            </param>
        </page>
    </param>
    <label>Options de dessin</label>
    <param name="delete_existing_guides" type="bool" gui-text="Supprimer les guides existants">false</param>
    <param name="draw_edge_guides" type="bool" gui-text="Guides sur les bords des étiquettes">true</param>
    <param name="draw_centre_guides" type="bool" gui-text="Guides au centre des étiquettes">true</param>
    <param name="inset" type="float" min="0" max="1000" gui-text="Retrait des guides">5</param>
    <param name="draw_inset_guides" type="bool" gui-text="Guides en retrait des étiquettes">true</param>
    <param name="draw_shapes" type="bool" gui-text="Dessiner la forme des étiquettes">true</param>
    <param name="shape_inset" type="float" min="0" max="1000" gui-text="Retrait des formes">5</param>
    <param name="draw_inset_shapes" type="bool" gui-text="Dessiner les formes en retrait">true</param>
    <param name="set_page_size" type="bool" gui-text="Régler la taille de page (préréglages seulement)">false</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Grilles, repères et mesures" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">label_guides.py</command>
    </script>
</inkscape-extension>