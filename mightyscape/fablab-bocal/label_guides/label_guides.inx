                <option value="L7656">Étiquettes 46 x 11,1 mm (84/feuille, A4) [L7656, LP84/46]</option>
                <option value="L7658">Étiquettes 25,4 x 10 mm (189/feuille, A4) [L7658, LP189/25]</option>
                <option value="L7657">Étiquettes 17,8 x 10 mm (270/feuille, A4) [L7657, LP270/18]</option>
                <option value="LP6_95SQ">Étiquettes 95 x 95 mm (6/feuille, A4) [LP6/95SQ]</option>
                <option value="LP12_65SQ">Étiquettes 65 x 65 mm (12/feuille, A4) [LP12/65SQ]</option>
                <option value="LP15_51SQ">Étiquettes 51 x 51 mm (15/feuille, A4) [LP15/51SQ]</option>
                <option value="LP35_37SQ">Étiquettes 37 x 37 mm (35/feuille, A4) [LP35/37SQ]</option>
                <option value="LP70_25SQ">Étiquettes 25 x 25 mm (70/feuille, A4) [LP70/25SQ]</option>
            </param>
            <param name="rrect_radius" type="float" min="0" max="100" gui-text="Rayon des coins">1</param>
        </page>
        <page name="rect" gui-text="Préréglage (rectangle à angles droits)">
