<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Texte des cellules sélectionnées</name>
    <id>fablabchemnitz.de.table_edit_text</id>
    <param name="size" type="string" gui-text="Taille de police :">12px</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Tableaux"><submenu name="Modifier" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">table_edit_text.py</command>
    </script>
</inkscape-extension>