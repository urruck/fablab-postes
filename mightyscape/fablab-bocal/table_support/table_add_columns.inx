<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Colonnes</name>
    <id>fablabchemnitz.de.table_add_columns</id>
    <param name="number" type="int" gui-text="Nombre de colonnes à ajouter :">1</param>
    <param name="where" type="optiongroup" appearance="radio" gui-text="Avant ou après la colonne sélectionnée :">
        <option value="before">Avant</option>
        <option value="after">Après</option>
    </param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Tableaux"><submenu name="Ajouter" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">table_add_columns.py</command>
    </script>
</inkscape-extension>