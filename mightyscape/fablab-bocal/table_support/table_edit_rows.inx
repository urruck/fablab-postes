<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Hauteur des rangées sélectionnées</name>
    <id>fablabchemnitz.de.table_edit_rows</id>
    <param name="height" type="string" gui-text="Nouvelle hauteur :">10mm</param>
    
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Tableaux"><submenu name="Modifier" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">table_edit_rows.py</command>
    </script>
</inkscape-extension>