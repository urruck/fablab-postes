<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Distorsion exponentielle</name>
    <id>fablabchemnitz.de.exponential_distort</id>
    <param name="exponent" type="float" min="0.01" max="100" precision="2" gui-text="Exposant :">1.33</param>
    <param name="padding_perc" type="float" min="0" max="500" precision="0" gui-text="Marge [%] :">0</param>
    <label>Ajoute une marge pour adoucir l'effet. Sans marge, la courbe exponentielle va de 0 à 1. Avec par exemple 100 % de marge, elle va de 0,5 à 1.</label>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Transformations" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">exponential_distort.py</command>
    </script>
</inkscape-extension>