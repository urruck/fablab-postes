<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Marques d'impression pointillées</name>
    <id>fablabchemnitz.de.printing_marks_dotted</id>
    <param name="tab" type="notebook">
        <page name="marks" gui-text="Graduations">
            <param name="crop_marks" type="bool" gui-text="Traits de coupe">true</param>
            <param name="dotted_crop_marks" type="bool" gui-text="Traits de coupe pointillés">false</param>
            <param name="bleed_marks" type="bool" gui-text="Marques de fond perdu">false</param>
            <param name="registration_marks" type="bool" gui-text="Repères d'enregistrement">true</param>
            <param name="star_target" type="bool" gui-text="Mire en étoile">false</param>
            <param name="colour_bars" type="bool" gui-text="Barres de couleur">true</param>
            <param name="page_info" type="bool" gui-text="Informations de page">false</param>
        </page>
        <page name="pos" gui-text="Positionnement">
            <param name="where" type="optiongroup" appearance="combo" gui-text="Placer les traits de coupe sur :">
                <option value="canvas">Le canevas</option>
                <option value="selection">La sélection</option>
            </param>
            <param name="unit" type="optiongroup" appearance="combo" gui-text="Unité :">
                <option value="px">px</option>
                <option value="pt">pt</option>
                <option value="in">in</option>
                <option value="cm">cm</option>
                <option value="mm">mm</option>
            </param>
            <param name="crop_offset" type="float" min="0.0" max="9999.0" precision="3" gui-text="Décalage :">5</param>
            <label appearance="header">Fond perdu</label>
            <param name="bleed_top" type="float" indent="1" min="0.0" max="9999.0" precision="3" gui-text="Haut :">5</param>
            <param name="bleed_bottom" type="float" indent="1" min="0.0" max="9999.0" precision="3" gui-text="Bas :">5</param>
            <param name="bleed_left" type="float" indent="1" min="0.0" max="9999.0" precision="3" gui-text="Gauche :">5</param>
            <param name="bleed_right" type="float" indent="1" min="0.0" max="9999.0" precision="3" gui-text="Droite :">5</param>
        </page>
    </param>
    <effect needs-live-preview="true">
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Découpe laser et traceur" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">printing_marks_dotted.py</command>
    </script>
</inkscape-extension>