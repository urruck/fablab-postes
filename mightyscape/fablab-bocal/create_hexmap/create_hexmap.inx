<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Créer une carte hexagonale</name>
    <id>fablabchemnitz.de.create_hexmap</id>
    <param name="tab" type="notebook">
        <page name="page_1" gui-text="Taille">
            <param name="units" type="optiongroup" appearance="combo" gui-text="Unités de taille">
               <option value="mm">mm</option>
               <option value="cm">cm</option>
               <option value="in">in</option>
               <option value="pt">pt</option>
               <option value="px">px</option>
            </param>
            <param name="cols" type="int" gui-text="Colonnes" min="1" max="1000000">10</param>
            <param name="rows" type="int" gui-text="Rangées" min="1" max="1000000">10</param>
            <param name="hexsize" type="float" min="0" max="9999" gui-text="Taille des hexagones (facultatif)">0</param>
            <param name="strokewidth" type="float" min="0.0" max="9999.0" gui-text="Épaisseur du contour">1.0</param>
            <param name="verticesize" type="float" min="0.0" max="50.0" gui-text="Taille des sommets (%)">10.0</param>
        </page>
        <page name="page_2" gui-text="Style">
            <param name="bricks" type="bool" gui-text="Briques">false</param>
            <param name="squarebricks" type="bool" gui-text="Forcer des briques carrées">false</param>
            <param name="rotate" type="bool" gui-text="Pivoter">false</param>
            <param name="halfhexes" type="bool" gui-text="Demi-hexagones en haut et en bas">false</param>
            <param name="xshift" type="bool" gui-text="Décaler la grille sur le côté et boucler">false</param>
            <param name="firstcoldown" type="bool" gui-text="Première colonne décalée d'un demi-hexagone vers le bas">false</param>
        </page>
        <page name="page_3" gui-text="Coordonnées">
            <param name="coordseparator" type="string" gui-text="Séparateur de coordonnées">.</param>
            <param name="coordalphacol" type="bool" gui-text="Colonnes en lettres">false</param>
            <param name="coordrevrow" type="bool" gui-text="Coordonnées de rangée inversées">false</param>
            <param name="coordrowfirst" type="bool" gui-text="Coordonnée de rangée en premier">false</param>
            <param name="coordzeros" type="bool" gui-text="Coordonnées complétées par des zéros">true</param>
            <param name="coordrows" type="int" min="1" max="100" gui-text="Coordonnées toutes les ... rangées">1</param>
            <param name="coordcolstart" type="int" gui-text="N° de première colonne" min="0" max="1000">1</param>
            <param name="coordrowstart" type="int" gui-text="N° de première rangée" min="0" max="1000">1</param>
        </page>
        <page name="page_4" gui-text="Calques">
            <param name="layer_grid" type="bool" gui-text="Grille">true</param>
            <param name="layer_fill" type="bool" gui-text="Remplissage (#ffffff)">true</param>
            <param name="layer_coordinates" type="bool" gui-text="Coordonnées">true</param>
            <param name="layer_centerdots" type="bool" gui-text="Points centraux">true</param>
            <param name="layer_vertices" type="bool" gui-text="Sommets">false</param>
            <param name="layer_circles" type="bool" gui-text="Cercles">false</param>
            <param name="layersingroup" type="bool" gui-text="Calques dans un groupe">false</param>
        </page>
        <page name="page_5" gui-text="Débogage">
            <param name="generatelog" type="bool" gui-text="Créer un fichier journal">false</param>
            <param name="logfilepath" type="path" gui-text="Fichier journal (facultatif)" mode="file_new" filetypes="txt">debug.txt</param>
        </page>
    </param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Grilles, repères et mesures" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">create_hexmap.py</command>
    </script>
</inkscape-extension>