<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
	<name>Ouvrir un chemin fermé</name>
	<id>fablabchemnitz.de.open_closed_path</id>
	<effect>
        <object-type>path</object-type>
		<effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Chemins"><submenu name="Modifier" /></submenu></submenu></effects-menu>
	</effect>
	<script>
		<command location="inx" interpreter="python">open_closed_path.py</command>
	</script>
</inkscape-extension>