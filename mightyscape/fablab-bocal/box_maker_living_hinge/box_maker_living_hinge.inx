<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Générateur de boîte - Charnière souple</name>
    <id>fablabchemnitz.de.box_maker_living_hinge</id>
    <param name="hingeOpt" gui-text="Type de charnière" type="optiongroup" appearance="combo">
        <option value="0">Fentes parallèles standard</option>
        <option value="1">Spirale simple</option>
        <option value="2">Double spirale</option>
        <option value="3">Serpentin parallèle</option>
        <option value="4">Serpentin perpendiculaire</option>
        <option value="5">Double serpentin perpendiculaire</option>
    </param>
    <param name="unit" gui-text="Unité" type="optiongroup" appearance="combo">
        <option value="mm">mm</option>
        <option value="cm">cm</option>
        <option value="in">in</option>
    </param>
    <param name="inside" type="optiongroup" appearance="combo" gui-text="Dimensions de la boîte">
        <option value="1">Intérieur</option>
        <option value="0">Extérieur</option>
    </param>
    <param name="length" type="float" precision="3" min="0.0" max="10000.0" gui-text="Longueur">40.0</param>
    <param name="width" type="float" precision="3" min="0.0" max="10000.0" gui-text="Largeur">80.0</param>
    <param name="height" type="float" precision="3" min="0.0" max="10000.0" gui-text="Hauteur">50.0</param>
    <param name="tab" type="float" precision="2" min="0.0" max="10000.0" gui-text="Largeur de languette minimale / souhaitée">6.0</param>
    <param name="equal" type="optiongroup" appearance="combo" gui-text="Largeur des languettes">
        <option value="0">Fixe</option>
        <option value="1">Proportionnelle</option>
    </param>
    <param name="thickness" type="float" precision="2" min="0.0" max="10000.0" gui-text="Épaisseur du matériau">3.0</param>
    <param name="kerf" type="float" precision="3" min="0.0" max="10000.0" gui-text="Trait de coupe (largeur de coupe)">0.1</param>
    <param name="clearance" type="float" precision="3" min="0.0" max="10000.0" gui-text="Jeu">0.01</param>
    <param name="style" gui-text="Disposition / style" type="optiongroup" appearance="combo">
        <option value="0">Schématique</option>
        <option value="1">En ligne (compacte)</option>
    </param>
    <param name="spacing" type="float" precision="2" min="0.0" max="10000.0" gui-text="Espace entre les pièces">1.0</param>
    <param name="hingeThick" type="float" precision="3" min="0.0" max="10000.0" gui-text="Épaisseur de bois restante à la charnière">2.0</param>
    <param name="thumbTab" type="float" precision="3" min="0.0" max="10000.0" gui-text="Longueur de la languette d'ouverture du couvercle (0 = aucune)">15.000</param>
    <effect needs-live-preview="true">
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Boîtes (autres modèles)"><submenu name="À encoches" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">box_maker_living_hinge.py</command>
    </script>
</inkscape-extension>