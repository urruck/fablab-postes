<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Cadre simple</name>
    <id>fablabchemnitz.de.simple_frame</id>
    <param name="unit" gui-text="Unité :" type="optiongroup" appearance="combo">
        <option value="mm">mm</option>
    </param>
    <param name="width" type="float" min="0.1" max="300.0" gui-text="Largeur intérieure :">100.0</param>
    <param name="height" type="float" min="0.1" max="300.0" gui-text="Hauteur intérieure :">150.0</param>
    <param name="depth" type="float" min="0.1" max="300.0" gui-text="Profondeur">10.0</param>
    <param name="border" type="float" min="0.1" max="300.0" gui-text="Largeur de la bordure du cadre">20.0</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Boîtes (autres modèles)"><submenu name="Carton et papier" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">simple_frame.py</command>
    </script>
</inkscape-extension>