<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
	<name>Exporter la sélection en...</name>
	<id>fablabchemnitz.de.export_selection_as</id>
    <param name="tab" type="notebook">
        <page name="tab_settings" gui-text="Paramètres">
        	<param name="wrap_transform" type="bool" gui-text="Englober le document final dans une transformation">false</param>
            <param name="border_offset" type="float" min="0.000" max="9999.000" precision="3" gui-text="Ajouter une marge autour de la sélection">1.000</param>
            <param name="border_offset_unit" type="optiongroup" appearance="combo" gui-text="Unité de la marge">
                <option value="mm">mm</option>
                <option value="cm">cm</option>
                <option value="px">px</option>
                <option value="pt">pt</option>
                <option value="pc">pc</option>
                <option value="in">in</option>
            </param>
        	<param name="export_dir" type="path" mode="folder" gui-text="Dossier d'enregistrement des documents exportés">./inkscape_export/</param>
            <param name="opendir" type="bool" gui-text="Ouvrir le dossier de sortie après l'export">false</param>
        	<param name="dxf_exporter_path" type="path" mode="file" filetypes="py" gui-text="Emplacement de dxf_outlines.py" gui-description="Ne pas utiliser dxf12_outlines.py ! Cela tenterait de créer des DXF R12, ce qui échouera !">/usr/share/inkscape/extensions/dxf_outlines.py</param>
            <param name="export_svg" type="bool" gui-text="Exporter en SVG">true</param>
            <param name="export_dxf" type="bool" gui-text="Exporter en DXF R14 (unités mm)">false</param>
            <param name="export_pdf" type="bool" gui-text="Exporter en PDF 1.5">false</param>
            <param name="export_png" type="bool" gui-text="Exporter en PNG">false</param>
            <param name="png_dpi" type="float" min="1" max="2400" precision="3" gui-text="Résolution PNG en ppp (pour l'export et le remplacement)" gui-description="par défaut : 96">96</param>
            <param name="replace_by_png" type="bool" gui-text="Remplacer par un PNG" gui-description="Convertissez les contours en chemins pour garder la taille exacte et éviter les coupures !">false</param>
            <param name="newwindow" type="bool" gui-text="Ouvrir le fichier dans une nouvelle fenêtre Inkscape">false</param>
            <param name="skip_errors" type="bool" gui-text="Ignorer les erreurs">false</param>
            <label>Remarque : des fichiers svg/dxf/pdf déjà existants peuvent être supprimés ou écrasés par erreur. Faites attention !</label>
        </page>
        <page name="tab_about" gui-text="À propos">
            <label appearance="header">Exporter la sélection en...</label>
            <label>Extension pour exporter la sélection dans différents formats : SVG, DXF ou PDF.</label>
            <label>2021 / écrit par Mario Voigt (Stadtfabrikanten e.V. / FabLab Chemnitz)</label>
            <spacer />
            <label appearance="header">Documentation en ligne</label>
            <label appearance="url">https://y.stadtfabrikanten.org/export-selection-as</label>
            <spacer />
            <label appearance="header">Contribuer</label>
            <label appearance="url">https://gitea.fablabchemnitz.de/FabLab_Chemnitz/mightyscape-1.2</label>
            <label appearance="url">mailto:mario.voigt@stadtfabrikanten.org</label>
            <spacer />
            <label appearance="header">Basé sur</label>
            <label appearance="url">https://github.com/mireq/inkscape-export-selection-as-svg</label>
            <spacer />
            <label appearance="header">Collection d'extensions MightyScape</label>
            <label>Ce logiciel fait partie de la collection d'extensions MightyScape pour Inkscape, sous licence GNU GPL v3</label>
            <label appearance="url">https://y.stadtfabrikanten.org/mightyscape-overview</label>
        </page>
        <page name="tab_donate" gui-text="Faire un don">
            <label appearance="header">Café + pizza</label>
            <label>Nous sommes les Stadtfabrikanten, qui font vivre le FabLab Chemnitz depuis 2016. Un FabLab est un atelier ouvert qui donne accès à des machines et des outils numériques : imprimantes 3D, découpeuses laser, fraiseuses CNC.</label>
            <spacer />           
            <label>Vous aimez notre travail et voulez nous soutenir ? Vous pouvez faire un don à notre association de différentes façons :</label>
            <label appearance="url">https://y.stadtfabrikanten.org/donate</label>
            <spacer />
            <label>Merci d'utiliser notre extension et de nous aider !</label>
            <image>../000_about_fablabchemnitz.svg</image>
        </page>
    </param>
	<effect needs-document="true" needs-live-preview="false">
		<object-type>all</object-type>
		<effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Import et export" /></submenu></effects-menu>
        <menu-tip>Export selection to separate files.</menu-tip>
	</effect>
	<script>
		<command location="inx" interpreter="python">export_selection_as.py</command>
	</script>
</inkscape-extension>