<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Purger les nœuds en double</name>
    <id>fablabchemnitz.de.purge_duplicate_path_nodes</id>
    <param type="notebook" name="tab">
        <page name="options" gui-text="Options">
            <label>Supprime les nœuds en double des chemins sélectionnés.</label>
            <param name="minUse" type="bool" gui-text="Fusionner les nœuds des segments plus courts que la longueur indiquée">false</param>
            <param name="minlength" indent="4" type="float" precision="2" min="0" max="9999" gui-text="Longueur de segment minimale">0.01</param>
            <param name="joinEnd" type="bool" gui-text="Fermer les sous-chemins dont le début et la fin sont à moins de">false</param>
            <param name="maxdist" indent="4" type="float" precision="2" min="0" max="9999" gui-text="Limite">0.01</param>
            <param name="joinEndSub" type="bool" gui-text="Joindre les extrémités de sous-chemins séparés à moins de">false</param>
            <param name="maxdist2" indent="4" type="float" precision="2" min="0" max="9999" gui-text="Limite">0.01</param>
            <param name="allowReverse" indent="4" type="bool" gui-text="Autoriser l'inversion du sens des sous-chemins">true</param>
            <param name="optionJoin" indent="4" type="optiongroup" appearance="combo" gui-text="Joindre les sous-chemins en">
                <option value="1">fusionnant les nœuds</option>
                <option value="2">ajoutant un segment droit</option>
            </param>
            <label>Unité définie dans le document (Fichier &gt; Propriétés du document).</label>
        </page>
        <page name="help" gui-text="Informations">
            <label xml:space="preserve">Créé à l'origine pour nettoyer les chemins destinés aux découpeuses / traceurs : supprime les nœuds en trop et les petits espaces.

Les nœuds en double (coordonnées strictement identiques) sont toujours supprimés.
Pour joindre des chemins, ils doivent déjà être combinés (sous-chemins d'un même chemin).
Pour combiner des chemins, sélectionnez-les et faites Ctrl + K.</label> 
            <label appearance="header">Pour plus d'informations</label>
            <label appearance="url">https://gitlab.com/EllenWasbo/inkscape-extension-removeduplicatenodes</label>
        </page>
    </param>
    <effect>
        <object-type>path</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Chemins"><submenu name="Couper et nettoyer" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">purge_duplicate_path_nodes.py</command>
    </script>
</inkscape-extension>