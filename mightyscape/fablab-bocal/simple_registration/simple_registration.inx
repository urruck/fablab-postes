<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Repérage simple</name>
    <id>fablabchemnitz.de.simple_registration</id>
    <param name="simple_registration_notebook" type="notebook">
        <page name="reg_page" gui-text="Repère">
            <param name="color_picker_reg_object" type="color" appearance="colorbutton" gui-text="Couleur du repère">0xff0000ff</param>
            <param name="reg_mark_type" type="optiongroup" appearance="combo" gui-text="Repère d'enregistrement" gui-description="Dessin du repère d'enregistrement">
                <option value="crosshair_path">Réticule</option>
                <option value="spiral_path">Spirale</option>
                <option value="star_path">Étoile</option>
                <option value="circle_path">Cercle</option>
                <option value="square_path">Carré</option>
            </param>
            <param name="reg_mark_scale" type="float" min="-100" max="100" gui-text="Taille du repère" gui-description="Facteur d'échelle du repère d'enregistrement">1</param>
            <param name="reg_mark_x_shift" type="float" min="-100" max="100" gui-text="X_Shift" gui-description="Décalage X du repère d'enregistrement">10</param>
            <param name="reg_mark_y_shift" type="float" min="-100" max="100" gui-text="Y_Shift" gui-description="Décalage Y du repère d'enregistrement">10</param>
            <param name="correct_layer_transform_checkbox" type="bool" gui-text="Corriger la transformation du calque" gui-description="Compenser les transformations de calque existantes">true</param>
        </page>
        <page name="tick_page" gui-text="Graduations">
            <param name="color_picker_tick" type="color" appearance="colorbutton" gui-text="Couleur des graduations">0x000000ff</param>
            <param name="tick_color_random_checkbox" type="bool" gui-text="Couleur des graduations aléatoire">false</param>
            <param name="tick_text_labels_checkbox" type="bool" gui-text="Étiquettes de texte">true</param>
            <param name="tick_text_label_font_size" type="float" min="-2" max="100" gui-text="Taille de police" gui-description="Taille de police des étiquettes">2</param>
            <vbox>
                <vbox>
                    <param name="tick_type" type="optiongroup" appearance="combo" gui-text="Type de graduation" gui-description="Type de graduation">
                        
                        <option value="circle_path">Cercle</option>
                        
                        
                        
                    </param>
                </vbox>
                <vbox>
                    <param name="tick_circle_radius" type="float" min="0.1" max="100" gui-text="Rayon" gui-description="Rayon du cercle">20</param>
                </vbox>
            </vbox>
            <vbox>
                <hbox>
                    <param name="tick_top_checkbox" type="bool" gui-text="Graduations en haut" gui-description="Graduations sur le bord du haut">true</param>
                    <param name="tick_left_checkbox" type="bool" gui-text="Graduations à gauche" gui-description="Graduations sur le bord gauche">true</param>
                </hbox>
                <hbox>
                    <param name="tick_bottom_checkbox" type="bool" gui-text="Graduations en bas" gui-description="Graduations sur le bord du bas">true</param>
                    <param name="tick_right_checkbox" type="bool" gui-text="Graduations à droite" gui-description="Graduations sur le bord droit">true</param>
                </hbox>
            </vbox>
        </page>
        <page name="about_page" gui-text="À propos">
            <label>Repérage simple - une extension Inkscape</label>
            <label>
                Inkscape 1.1 +
            </label>
            <label appearance="url">https://inkscape.org/~inklinea/resources/=extension/</label>
            <label xml:space="preserve">▶ numérotation selon l'ordre z

▶ Peut être trompé par des calques qui ont déjà des transformations - attention</label>
        </page>
    </param>
    <effect>
        <object-type>path</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Découpe laser et traceur" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">simple_registration.py</command>
    </script>
</inkscape-extension>