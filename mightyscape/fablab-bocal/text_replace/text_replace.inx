<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Remplacer le texte</name>
    <id>fablabchemnitz.de.text_replace</id>
    <param name="replace" type="bool" gui-text="Activer le remplacement">true</param>
    <param name="replacewith" type="string" gui-text="Nouveau contenu à insérer">lorem ipsum</param>
    <param name="tspan_merge" type="bool" gui-text="Fusionner les éléments tspan">true</param>
    <param name="clean" type="bool" gui-text="Supprimer les espaces en trop">true</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Texte" /></submenu></effects-menu>
       <menu-tip>Replace text elements with generic content.</menu-tip>
    </effect>
    <script>
        <command location="inx" interpreter="python">text_replace.py</command>
    </script>
</inkscape-extension>