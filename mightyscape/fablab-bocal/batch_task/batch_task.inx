<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Tâche en lot</name>
    <id>fablabchemnitz.de.batch_task</id>
    <param name="tab_main" type="notebook">
        <page name="Options" gui-text="Options">
            <param name="target" type="optiongroup" appearance="radio" gui-text="XPath appliqué à :">
                <option value="root">Tout le document</option>
                <option value="selected">Objets sélectionnés seulement</option>
            </param>
            <param name="xpath" type="string" gui-text="XPath :" gui-description="par défaut : '.'">.</param>
            <param name="tab_effect" type="notebook">
                <page name="Preset" gui-text="Préréglages">
                    <param name="effect_preset1" type="optiongroup" appearance="combo" gui-text="Effet préréglé 1 :">
                        <option value="">Ne rien faire</option>
                        <option value="duplicate">duplicate</option>
                        <option value="delete-selection">delete-selection</option>
                        <option value="selection-group">selection-group</option>
                        <option value="selection-ungroup">selection-ungroup</option>
                        <option value="selection-raise">selection-raise</option>
                        <option value="selection-lower">selection-lower</option>
                        <option value="selection-top">selection-top</option>
                        <option value="selection-bottom">selection-bottom</option>
                        <option value="org.inkscape.color.brighter">Plus clair</option>
                        <option value="org.inkscape.color.darker">Plus sombre</option>
                    </param>
                    <param name="effect_preset2" type="optiongroup" appearance="combo" gui-text="Effet préréglé 2 :">
                        <option value="">Ne rien faire</option>
                        <option value="duplicate">duplicate</option>
                        <option value="delete-selection">delete-selection</option>
                        <option value="selection-group">selection-group</option>
                        <option value="selection-ungroup">selection-ungroup</option>
                        <option value="selection-raise">selection-raise</option>
                        <option value="selection-lower">selection-lower</option>
                        <option value="selection-top">selection-top</option>
                        <option value="selection-bottom">selection-bottom</option>
                        <option value="org.inkscape.color.brighter">Plus clair</option>
                        <option value="org.inkscape.color.darker">Plus sombre</option>
                    </param>
                    <param name="effect_preset3" type="optiongroup" appearance="combo" gui-text="Effet préréglé 3 :">
                        <option value="">Ne rien faire</option>
                        <option value="duplicate">duplicate</option>
                        <option value="delete-selection">delete-selection</option>
                        <option value="selection-group">selection-group</option>
                        <option value="selection-ungroup">selection-ungroup</option>
                        <option value="selection-raise">selection-raise</option>
                        <option value="selection-lower">selection-lower</option>
                        <option value="selection-top">selection-top</option>
                        <option value="selection-bottom">selection-bottom</option>
                        <option value="org.inkscape.color.brighter">Plus clair</option>
                        <option value="org.inkscape.color.darker">Plus sombre</option>
                    </param>
                </page>
                <page name="Simple" gui-text="Simple">
                    <param name="effect_simple1" type="string" gui-text="Effet 1 :" />
                    <param name="effect_simple2" type="string" gui-text="Effet 2 :" />
                    <param name="effect_simple3" type="string" gui-text="Effet 3 :" />
                </page>
                <page name="Multi" gui-text="Multiple">
                    <param name="effect_multi" type="string" gui-text="Effets :" appearance="multiline" />
                </page>
            </param>
            
            
            
            <param name="mode" type="optiongroup" appearance="radio" gui-text="Appliquer les effets à :">
                <option value="all">Toute la sélection</option>
                <option value="indiv">Chaque objet de la sélection</option>
            </param>
        </page>
        <page name="Help" gui-text="Aide">
            <label xml:space="preserve">Ce modèle sert de base aux auteurs d'extensions pour écrire rapidement et proprement leurs extensions Inkscape en Python.

Ce texte d'aide d'essai peut être modifié pour aider les utilisateurs de l'extension.</label>
        </page>
        <page name="null_Reference" gui-text="Référence">
            
            <param name="null_notebook" type="notebook">
                <page name="null_edit" gui-text="Édition">
                    <label xml:space="preserve">cut
copy
paste-size</label>
                    <separator />
                    <label xml:space="preserve">duplicate
clone
selection-make-bitmap-copy</label>
                    <separator />
                    <label xml:space="preserve">delete</label>
                </page>
                <page name="null_objects" gui-text="Objets">
                    <label xml:space="preserve">selection-group
selection-ungroup</label>
                    <separator />
                    <label xml:space="preserve">object-set-clip
object-release-clip
object-set-mask
object-release-mask</label>
                    <separator />
                    <label xml:space="preserve">selection-raise
selection-lower
selection-top
selection-bottom</label>
                </page>
                <page name="null_objects_2" gui-text="Objets 2">
                    <label xml:space="preserve">object-rotate-90-cw
object-rotate-90-ccw
object-flip-horizontal
object-flip-vertical</label>
                    <separator />
                    <label xml:space="preserve">unhide-all
unlock-all</label>
                </page>
                <page name="null_path" gui-text="Chemin">
                    <label xml:space="preserve">path-union
path-difference
path-intersection</label>
                    <separator />
                    <label xml:space="preserve">path-exclusion
path-division
path-cut</label>
                    <separator />
                    <label xml:space="preserve">path-combine
path-break-apart</label>
                </page>
                <page name="null_text" gui-text="Texte">
                    <label xml:space="preserve">text-unkern</label>
                </page>
                <page name="null_filters" gui-text="Filtres">
                    <label xml:space="preserve">org.inkscape.color.brighter
org.inkscape.color.darker
org.inkscape.color.grayscale
org.inkscape.color.black_and_white</label>
                </page>
                <page name="null_extensions" gui-text="Extensions">
                    <label xml:space="preserve">last-effect</label>
                </page>
            </param>
            
        </page>
    </param>
    <param name="dry_run" type="bool" gui-text="Essai à blanc (sans rien modifier)">true</param>
    <effect>
        <object-type>all</object-type>
        
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Divers" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">batch_task.py</command>
    </script>
</inkscape-extension>