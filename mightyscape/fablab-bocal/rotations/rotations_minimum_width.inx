<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Rotations - largeur minimale</name>
    <id>fablabchemnitz.de.rotations_minimum_width</id>
    <param name="precision" type="int" min="1" max="72000" gui-text="Précision (pas) :" gui-description="Par défaut : 360">360</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Transformations" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">rotations_minimum_width.py</command>
    </script>
</inkscape-extension>