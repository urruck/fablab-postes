<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Dessiner sens et déplacements à vide</name>
    <id>fablabchemnitz.de.draw_directions_tavel_moves</id>
    <param name="nb_main" type="notebook">
        <page name="tab_draw" gui-text="Dessiner">
            <param name="order" type="optiongroup" appearance="combo" gui-text="Ordre">
                <option value="separate_groups">Dans des groupes séparés</option>
                <option value="separate_layers">Dans des calques séparés</option>
                <option value="element_index">À la position de l'élément</option>
            </param>
            <separator />
            <param name="draw_dots" type="bool" gui-text="Dessiner des points" gui-description="Début et fin des chemins ouverts (rouge + bleu) et fermés (vert + jaune)">true</param>
            <param name="dotsize" type="int" min="1" max="9999" gui-text="Taille des points (px)">10</param>
            <separator />
            <param name="draw_travel_moves" type="bool" gui-text="Dessiner les déplacements à vide">false</param>
            <param name="ignore_colors" type="bool" gui-text="Ignorer les couleurs de contour" gui-description="Si activé, toutes les lignes sont reliées dans l'ordre sans tenir compte de la couleur (sinon un groupe de déplacements par couleur)">false</param>
            <param name="dashed_style" type="bool" gui-text="Style pointillé">true</param>
            <param name="arrow_style" type="bool" gui-text="Style flèche">true</param>
            <param name="arrow_size" type="float" min="0.1" max="10.0" precision="2" gui-text="Taille des flèches (échelle)">1.0</param>
            <separator />
            <param name="debug" type="bool" gui-text="Afficher les infos de débogage">false</param>
        </page>
        <page name="tab_remove" gui-text="Supprimer">
        <label>Si cet onglet est sélectionné, cliquez simplement sur « Appliquer » pour supprimer tous les anciens déplacements / groupes.</label>
        </page>  
        <page name="tab_about" gui-text="À propos">
            <label appearance="header">Dessiner sens et déplacements à vide</label>
            <label>Dessine les déplacements à vide et/ou des points marquant le début et la fin des chemins, pour montrer l'ordre des lignes.</label>
            <label>2021 - 2023 / écrit par Mario Voigt (Stadtfabrikanten e.V. / FabLab Chemnitz)</label>
            <spacer />
            <label appearance="header">Documentation en ligne</label>
            <label appearance="url">https://y.stadtfabrikanten.org/draw-directions-travel-moves</label>
            <spacer />
            <label appearance="header">Contribuer</label>
            <label appearance="url">https://gitea.fablabchemnitz.de/FabLab_Chemnitz/mightyscape-1.2</label>
            <label appearance="url">mailto:mario.voigt@stadtfabrikanten.org</label>
            <spacer />
            <label appearance="header">Collection d'extensions MightyScape</label>
            <label>Ce logiciel fait partie de la collection d'extensions MightyScape pour Inkscape, sous licence GNU GPL v3</label>
            <label appearance="url">https://y.stadtfabrikanten.org/mightyscape-overview</label>
        </page>
        <page name="tab_donate" gui-text="Faire un don">
            <label appearance="header">Café + pizza</label>
            <label>Nous sommes les Stadtfabrikanten, qui font vivre le FabLab Chemnitz depuis 2016. Un FabLab est un atelier ouvert qui donne accès à des machines et des outils numériques : imprimantes 3D, découpeuses laser, fraiseuses CNC.</label>
            <spacer />           
            <label>Vous aimez notre travail et voulez nous soutenir ? Vous pouvez faire un don à notre association de différentes façons :</label>
            <label appearance="url">https://y.stadtfabrikanten.org/donate</label>
            <spacer />
            <label>Merci d'utiliser notre extension et de nous aider !</label>
            <image>../000_about_fablabchemnitz.svg</image>
        </page>
    </param>
    <effect>
        <object-type>path</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Découpe laser et traceur" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">draw_directions_tavel_moves.py</command>
    </script>
</inkscape-extension>