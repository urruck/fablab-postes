<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Graduation de bouton rotatif</name>
    <id>fablabchemnitz.de.knob_scale</id>
    <param name="tab" type="notebook">
        <page name="general_settings" gui-text="Général">
            <param name="x" type="float" min="-1000" max="10000" precision="3" gui-text="Centre X :">0</param>
            <param name="y" type="float" min="-1000" max="10000" precision="3" gui-text="Centre Y :">0</param>
            <param name="radius" type="float" min="0.001" max="10000" precision="3" gui-text="Rayon du bouton :">100</param>
            <param name="angle" type="float" min="1.0" max="360.0" precision="3" gui-text="Angle (°)">300</param>
            <param name="angle_shifting" type="float" min="0.0" max="360.0" precision="3" gui-text="Décalage d'angle (°)">300</param>
            <param name="linewidth" type="float" min="0.001" max="100" precision="3" gui-text="Épaisseur de trait">1</param>
            <param name="draw_arc" type="bool" gui-text="Dessiner l'arc">true</param>
            <param name="draw_centering_circle" type="bool" gui-text="Dessiner le cercle de centrage">false</param>
            <param name="logarithmic_scale" type="bool" gui-text="Échelle logarithmique">false</param>
            <param name="invert" type="bool" gui-text="Inverser le sens">false</param>
            <param name="units" type="optiongroup" gui-text="Unités" appearance="combo">
                <option value="px">px</option>
                <option value="mm">mm</option>
            </param>
        </page>
        <page name="ticks_settings" gui-text="Graduations">
            <param name="n_ticks" type="int" min="2" max="100" gui-text="Nombre de graduations :">2</param>
            <param name="ticksize" type="float" min="0.001" max="1000" precision="3" gui-text="Taille des graduations :">10</param>
            <param name="n_subticks" type="int" min="0" max="100" gui-text="Nombre de sous-graduations :">1</param>
            <param name="subticksize" type="float" min="0.001" max="1000" precision="3" gui-text="Taille des sous-graduations :">5</param>
            <param name="style" type="optiongroup" gui-text="Style de l'échelle" appearance="combo">
                <option value="marks_inwards">Graduations vers l'intérieur</option>
                <option value="marks_outwards">Graduations vers l'extérieur</option>
                <option value="marks_circles">Points</option>
            </param>
        </page>
        <page name="labels_settings" gui-text="Étiquettes">
            <param name="labels_enabled" type="bool" gui-text="Activer les étiquettes">false</param>
            <param name="rounding_level" type="int" min="0" max="100" gui-text="Arrondir à">0</param>
            <param name="text_size" type="float" min="0.001" max="1000" precision="3" gui-text="Taille des étiquettes">10</param>
            <param name="text_offset" type="float" min="-1000" max="1000" precision="3" gui-text="Décalage">20</param>
            <param name="start_value" type="float" min="-10000" max="10000" precision="3" gui-text="Valeur de départ">0</param>
            <param name="stop_value" type="float" min="-10000" max="10000" precision="3" gui-text="Valeur d'arrivée">10</param>
        </page>
    </param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Mécanique et graduations" /></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">knob_scale.py</command>
    </script>
</inkscape-extension>