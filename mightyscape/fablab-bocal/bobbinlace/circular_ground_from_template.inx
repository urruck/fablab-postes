<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
   <name>Dentelle aux fuseaux - Fond circulaire depuis un modèle</name>
   <id>fablabchemnitz.de.bobbinlace.circular_ground_from_template</id>
   <label appearance="header">Enroule autour d'un cercle le motif de dentelle trouvé dans le fichier modèle.</label>
   <label>Remarque : le dessin peut devenir très grand si le « Nombre de copies autour du cercle » est petit ou si le « Diamètre » du cercle intérieur est grand.</label>
   <param name="file" type="path" gui-text="Nom du fichier modèle (chemin complet) :" mode="file" filetypes="txt">./templates/</param>
   <label appearance="header">Description de la grille</label>
   <hbox indent="1">
      <param name="angle" type="float" precision="1" min="30" max="89" gui-text="Angle (degrés) :">45.0</param>
   </hbox>
   <hbox indent="1">
      <param name="cols" type="int" min="3" max="1000" gui-text="Nombre de copies autour du cercle :">30</param>
   </hbox>
   <label appearance="header">Description de la pièce</label>
   <hbox indent="1">
      <param name="diameter" type="float" precision="2" min="0.1" max="1000" gui-text="Diamètre du cercle intérieur :">50</param>
      <param name="diamunits" gui-text=" " type="optiongroup" appearance="combo">
         <option value="mm">mm</option>
         <option value="cm">cm</option>
         <option value="in">in</option>
         <option value="px">px</option>
         <option value="pt">pt</option>
      </param>
   </hbox>
   <hbox indent="1">
      <param name="rows" type="int" min="1" max="1000" gui-text="Nombre de cercles :">3</param>
   </hbox>
   <label appearance="header">Apparence des lignes</label>
   <hbox indent="1">
      <param name="linewidth" type="float" precision="2" min="0.01" max="1000" gui-text="Largeur :">1</param>
      <param name="lineunits" gui-text=" " type="optiongroup" appearance="combo">
         <option value="px">px</option>
         <option value="mm">mm</option>
         <option value="cm">cm</option>
         <option value="in">in</option>
         <option value="pt">pt</option>
      </param>
   </hbox>
   <hbox indent="1">
      <param name="linecolor" type="color" appearance="colorbutton" gui-text="Couleur :">255</param>
   </hbox>
   <effect needs-live-preview="true">
      <object-type>all</object-type>
      <effects-menu>
         <submenu name="FabLab Boc@l"><submenu name="Grilles, repères et mesures" /></submenu></effects-menu>
   </effect>
   <script>
      <command location="inx" interpreter="python">circular_ground_from_template.py</command>
   </script>
</inkscape-extension>