<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
   <name>Dentelle aux fuseaux - Grille polaire</name>
   <id>fablabchemnitz.de.bobbinlace.polar_grid</id>
   <label>Crée une grille polaire de points imprimable, avec un nombre constant de points par cercle ; l'écart entre les cercles augmente au même rythme que l'écart entre les points d'un cercle.</label>
   <label appearance="header">Style de grille</label>
   <hbox indent="1">
      <param name="angle" type="float" precision="2" min="15" max="80" gui-text="Angle de la grille (degrés) :">45.0</param>
   </hbox>
   <hbox indent="1">
      <param name="dots" type="int" min="4" max="400" gui-text="Nombre de points par cercle :">180</param>
   </hbox>
   <hbox indent="1">
      <param name="variant" type="optiongroup" appearance="combo" gui-text="Motif :">
         <option value="">losange</option>
         <option value="rectangle">rectangle</option>
         <option value="hexagon1">hexagone (30°)</option>
         <option value="hexagon2">hexagone (60°, /3)</option>
         <option value="hexagon3">hexagone + triangle (30-45-60°, /2)</option>
         <option value="hexagon4">hexagone + losange (30°)</option>
         <option value="hexagon5">hexagone + losange (60°, /2)</option>
         <option value="snow2">neige, hexagone (60°, /6)</option>
         <option value="snow1">neige, hexagone + losange (60°, /8)</option>
      </param>
   </hbox>
   <label appearance="header">Taille de la grille</label>
   <hbox indent="1">
      <param name="outerDiameter" type="float" precision="2" min="0.5" max="500" gui-text="Diamètre extérieur :">160</param>
      <param name="circleDiameterUnits" gui-text=" " type="optiongroup" appearance="combo">
         <option value="mm">mm</option>
         <option value="cm">cm</option>
         <option value="in">in</option>
         <option value="px">px</option>
         <option value="pt">pt</option>
      </param>
   </hbox>
   <hbox indent="1">
      <param name="innerDiameter" type="float" precision="2" min="0.5" max="500" gui-text="Diamètre intérieur :">100</param>
   </hbox>
   <hbox indent="1">
      <param name="alignment" type="optiongroup" appearance="combo" gui-text="Aligner sur :">
         <option value="outside">le cercle extérieur</option>
         <option value="inside">le cercle intérieur</option>
      </param>
   </hbox>
   <label appearance="header">Propriétés des points</label>
   <hbox indent="1">
      <param name="size" type="float" precision="2" min="0.001" max="10" gui-text="Diamètre :">0.5</param>
      <param name="dotUnits" gui-text=" " type="optiongroup" appearance="combo">
         <option value="px">px</option>
         <option value="mm">mm</option>
         <option value="cm">cm</option>
         <option value="in">in</option>
         <option value="pt">pt</option>
      </param>
   </hbox>
   <hbox indent="1">
      <param name="fill" type="color" appearance="colorbutton" gui-text="Couleur :">255</param>
   </hbox>
   <effect needs-live-preview="true">
      <object-type>all</object-type>
      <effects-menu>
         <submenu name="FabLab Boc@l"><submenu name="Grilles, repères et mesures" /></submenu></effects-menu>
   </effect>
   <script>
      <command location="inx" interpreter="python">polar_grid.py</command>
   </script>
</inkscape-extension>