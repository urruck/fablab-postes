<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Polygone par côté</name>
    <id>fablabchemnitz.de.polygon_side</id>
    <param name="number_of_sides" type="int" min="1" max="100" gui-text="Nombre de côtés">3</param>
    <param name="length_of_sides" type="float" min="0.01" max="9999" gui-text="Longueur des côtés">25</param>
    <param name="unit_choice" type="optiongroup" appearance="radio" gui-text="Unités">
        <option value="1">Utilisateur</option>
        <option value="2">Pixels</option>
    </param>
    <effect>
        <object-type>path</object-type>
        <effects-menu>
         <submenu name="FabLab Boc@l"><submenu name="Formes et motifs"><submenu name="Générateurs" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">polygon_side.py</command>
    </script>
</inkscape-extension>