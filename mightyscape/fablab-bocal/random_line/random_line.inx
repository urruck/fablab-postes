<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Ligne aléatoire</name>
    <id>fablabchemnitz.de.random_line</id>
    <param name="height" type="int" min="100" max="1000" gui-text="Hauteur de la forme :">120</param>
    <param name="width" type="int" min="100" max="1000" gui-text="Largeur de la forme :">120</param>
    <param name="seg_count" type="int" min="1" max="1000" gui-text="Nombre de segments :">25</param>
    <label>v.01</label>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Formes et motifs"><submenu name="Générateurs" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">random_line.py</command>
    </script>
</inkscape-extension>