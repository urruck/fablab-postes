<?xml version='1.0' encoding='UTF-8'?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Générateur de boîte - Conique</name>
    <id>fablabchemnitz.de.box_maker_conical</id>
    <param name="unit" type="optiongroup" appearance="combo" gui-text="Unité">
        <option value="mm">mm</option>
        <option value="cm">cm</option>
        <option value="in">in</option>
        <option value="pt">pt</option>
        <option value="px">px</option>
        <option value="pc">pc</option>
    </param>
    <param name="thickness" type="float" min="1.0" max="10.0" gui-text="Épaisseur du matériau">3.0</param>
    <param name="d1" type="float" min="30.0" max="1000.0" gui-text="Diamètre du petit cercle">100.0</param>
    <param name="d2" type="float" min="31.0" max="1000.0" gui-text="Diamètre du grand cercle">150.0</param>
    <param name="zc" type="float" min="15.0" max="1000.0" gui-text="Hauteur du cône">50.0</param>
	<param name="nb_pieces" type="int" min="1" max="100" gui-text="Nombre de pièces du cône">1</param>
    <param name="inner_size" type="bool" gui-text="Dimensions intérieures">true</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="FabLab Boc@l"><submenu name="Boîtes (autres modèles)"><submenu name="À encoches" /></submenu></submenu></effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">box_maker_conical.py</command>
    </script>
</inkscape-extension>